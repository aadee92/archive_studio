import { ListView, LineEdit, Button, ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ScrollRestore, UiLog } from "nav.slint";
import { ItemMenu } from "menu.slint";

// A person tag with faces, or "Unknown" (key -1) for faces nobody has named yet.
export struct PersonItem {
    key: int,
    name: string,
    // The person tag ("People|Family|Ann"); "" for Unknown.
    path: string,
    count: int,
    // Their cover face, small; else `initial` on a plain disc.
    avatar: image,
    has-avatar: bool,
    initial: string,
}

// One face crop in the grid.
export struct FaceTile {
    thumb: image,
    thumb-ready: bool,
    // File name, or for a face only suggested as this person, how sure the suggestion is.
    detail: string,
    // Suggested rather than confirmed: highlighted, and listed before the confirmed faces.
    suggested: bool,
    selected: bool,
    // Named (or ignored) since the grid was loaded: the face stays where it is, masked
    // and labelled, until the grid is reloaded.
    assigned: string,
    ignored: bool,
}

export struct FaceRow { tiles: [FaceTile] }

export global PeopleBridge {
    // Unknown first, then the people `filter` matches, in `sort` order.
    in property <[PersonItem]> people;
    // 0: by name, 1: most faces first, 2: recently named first. Kept for the session.
    in-out property <int> sort: 0;
    in-out property <string> filter;
    in-out property <int> selected: -1;
    // Face crops, `columns` per row; a face is addressed by (row, column).
    in property <[FaceRow]> rows;
    in property <string> title;
    in property <string> status-text;
    in property <bool> empty;
    in property <bool> loading;
    in property <length> tile-size: 120px;
    // Faces selected in the grid.
    in property <int> selection: 0;
    // The person on screen ("" for Unknown): what the name box starts with.
    in property <string> person-name;
    // Person names matching the name box.
    in property <[string]> name-matches;
    // Scroll position of the face grid, reported by the page (see ReviewBridge).
    in-out property <int> scroll-row;
    in-out property <length> scroll-offset;
    // Set by Rust to scroll somewhere (Back).
    in property <ScrollRestore> restore;

    callback columns-changed(int);
    callback select(int);
    // `sort` or `filter` changed.
    callback arrange();
    // From a person's menu: "rename", "merge" or "delete" (opens `TagEdit`'s dialog).
    callback person-action(/* key */ int, string);
    // A person (key) was dropped on the row at this index of `people`: merge, once confirmed.
    callback merge-drop(int, int);
    // (row, column); -1 for neither when the click missed every face.
    callback open(int, int);
    // Right-click on a face. Shows the item context menu (`ItemMenu`).
    callback context-menu(int, int);
    callback click(int, int, /* extend */ bool, /* toggle */ bool);
    // A drag starts: `keep` adds to the current selection instead of replacing it.
    callback drag-begin(bool);
    // The faces in rows `r0..=r1`, columns `c0..=c1` (unclamped), plus what drag-begin kept.
    callback drag-to(int, int, int, int);
    callback select-all();
    callback clear-selection();
    callback name-edited(string);
    callback assign(string);
    callback ignore();
}

component FaceCell inherits Rectangle {
    in property <FaceTile> tile;
    in property <length> size;
    in property <bool> hover;

    width: size;

    Rectangle {
        y: 0;
        width: root.size;
        height: root.size;
        border-radius: 6px;
        clip: true;
        background: Theme.well;
        if root.tile.thumb-ready: Image {
            width: parent.width;
            height: parent.height;
            source: root.tile.thumb;
            image-fit: cover;
        }
        if root.tile.assigned != "": Rectangle {
            background: root.tile.ignored ? #ffffffc0 : #1f2328a8;
            Text {
                x: 6px;
                width: parent.width - 12px;
                text: root.tile.assigned;
                font-size: 13px;
                font-weight: 600;
                color: root.tile.ignored ? Theme.text-muted : #ffffff;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
    Rectangle {
        y: 0;
        width: root.size;
        height: root.size;
        border-radius: 6px;
        border-width: root.tile.selected ? 3px : root.hover ? 1px : 0px;
        border-color: root.tile.selected ? Theme.accent : Theme.border;
    }
    // Under a suggested face: a highlighted label.
    Rectangle {
        x: 0;
        y: root.size + 2px;
        width: root.size;
        height: 16px;
        border-radius: 4px;
        background: root.tile.suggested ? Theme.accent-soft : transparent;
        Text {
            x: 4px;
            width: parent.width - 8px;
            text: root.tile.detail;
            font-size: 11px;
            color: root.tile.suggested ? Theme.accent : Theme.text-muted;
            overflow: elide;
        }
    }
}

export component PeoplePage inherits Rectangle {
    property <length> gap: 12px;
    property <length> row-height: PeopleBridge.tile-size + 22px;
    property <length> pitch: PeopleBridge.tile-size + root.gap;
    property <int> columns: Math.max(1, Math.floor((list.visible-width - root.gap) / root.pitch));

    // Face under the pointer, for the hover border.
    property <int> hover-row: -1;
    property <int> hover-col: -1;

    // Rubber band, in content coordinates (scrolling moves the grid, not the band's anchor).
    property <bool> dragging;
    property <length> press-x;
    property <length> press-y;
    property <bool> press-keep;

    // The name box's match highlighted with Up / Down (-1: the typed text).
    property <int> match-index: -1;

    // The people list: row height, the person right-clicked, and a person being dragged
    // onto another (key -2: none) with the row under the pointer and where the pointer is.
    property <length> person-row: 36px;
    property <PersonItem> menu-person;
    property <int> drag-key: -2;
    property <string> drag-name;
    property <int> drop-index: -1;
    property <bool> dragged;
    property <length> drag-x;
    property <length> drag-y;

    function drop() {
        if (root.drop-index >= 0 && root.drop-index < PeopleBridge.people.length) {
            UiLog.debug("people.list", "person \{root.drag-key} dropped on row \{root.drop-index}");
            PeopleBridge.merge-drop(root.drag-key, root.drop-index);
        }
        root.drag-key = -2;
        root.drop-index = -1;
    }

    changed columns => { PeopleBridge.columns-changed(self.columns); }
    // `init` runs before Rust handles columns-changed, so the count is sent again here.
    // (Whether the catalog is re-read on showing the page, or the view left is restored,
    // is up to `nav.rs`.)
    changed visible => {
        UiLog.debug("people", "visible = \{self.visible ? "yes" : "no"}; \{root.lists-state()}");
        if (self.visible) {
            PeopleBridge.columns-changed(self.columns);
        }
    }
    init => { PeopleBridge.columns-changed(self.columns); }

    // Scroll position for snapshots, and scrolling back to one.
    property <length> scrolled: -list.content-y;
    changed scrolled => {
        PeopleBridge.scroll-row = Math.floor(self.scrolled / root.row-height);
        PeopleBridge.scroll-offset = self.scrolled - PeopleBridge.scroll-row * root.row-height;
    }
    property <ScrollRestore> restore: PeopleBridge.restore;
    changed restore => {
        list.content-y = Math.max(Math.min(0px, list.visible-height - list.content-height),
            Math.min(0px, -(self.restore.row * root.row-height + self.restore.offset)));
    }

    background: Theme.bg;

    // A person's menu, shown where they were right-clicked; never opened by its own clicks.
    person-menu-area := ContextMenuArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: false;
        Menu {
            MenuItem {
                title: "Rename…";
                activated => { PeopleBridge.person-action(root.menu-person.key, "rename"); }
            }
            MenuItem {
                title: "Merge into…";
                activated => { PeopleBridge.person-action(root.menu-person.key, "merge"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Delete person…";
                activated => { PeopleBridge.person-action(root.menu-person.key, "delete"); }
            }
        }
    }

    // Diagnostics (UiLog): the lists' models and scroll state, so the log shows a list that
    // is empty, scrolled past its end, or not where Rust thinks it is.
    pure function lists-state() -> string {
        return "people list: \{PeopleBridge.people.length} rows, content-y \{plist.content-y / 1px} of height \{plist.content-height / 1px} in \{plist.visible-height / 1px}; "
            + "faces: \{PeopleBridge.rows.length} rows × \{root.columns}, content-y \{list.content-y / 1px} of height \{list.content-height / 1px} in \{list.visible-height / 1px}; "
            + "selected \{PeopleBridge.selected}, loading \{PeopleBridge.loading ? "yes" : "no"}, empty \{PeopleBridge.empty ? "yes" : "no"}";
    }
    property <int> people-rows: PeopleBridge.people.length;
    changed people-rows => { UiLog.debug("people.list", "people model: \{self.people-rows} rows; \{root.lists-state()}"); }
    property <int> face-rows: PeopleBridge.rows.length;
    changed face-rows => { UiLog.debug("people.faces", "face model: \{self.face-rows} rows"); }
    property <int> selected-key: PeopleBridge.selected;
    changed selected-key => { UiLog.debug("people.list", "highlighted person key = \{self.selected-key}"); }
    property <bool> loading: PeopleBridge.loading;
    changed loading => { UiLog.debug("people", "loading = \{self.loading ? "yes" : "no"}"); }
    // Scrolled further than the content goes (a list that looks blank).
    property <bool> people-past-end: -plist.content-y > Math.max(0px, plist.content-height - plist.visible-height) + 1px;
    changed people-past-end => { UiLog.debug("people.list", "scrolled past the end: \{self.people-past-end ? "yes" : "no"}; \{root.lists-state()}"); }
    property <bool> faces-past-end: -list.content-y > Math.max(0px, list.content-height - list.visible-height) + 1px;
    changed faces-past-end => { UiLog.debug("people.faces", "scrolled past the end: \{self.faces-past-end ? "yes" : "no"}; \{root.lists-state()}"); }
    property <length> people-scroll: plist.content-y;
    changed people-scroll => { UiLog.trace("people.list", "content-y \{self.people-scroll / 1px} of height \{plist.content-height / 1px} in \{plist.visible-height / 1px}"); }
    property <length> faces-scroll: list.content-y;
    changed faces-scroll => { UiLog.trace("people.faces", "content-y \{self.faces-scroll / 1px} of height \{list.content-height / 1px} in \{list.visible-height / 1px}"); }

    pure function row-at(y: length) -> int {
        return y < 0 || Math.mod(y / 1px, root.row-height / 1px) < root.gap / 1px ? -1 : Math.floor(y / root.row-height);
    }
    pure function col-at(x: length) -> int {
        return x < root.gap || Math.floor((x - root.gap) / root.pitch) >= root.columns
            || Math.mod((x - root.gap) / 1px, root.pitch / 1px) > PeopleBridge.tile-size / 1px
            ? -1 : Math.floor((x - root.gap) / root.pitch);
    }

    function drag-update() {
        // Pointer in content coordinates.
        PeopleBridge.drag-to(
            Math.floor(Math.min(root.press-y, overlay.mouse-y - list.content-y) / root.row-height),
            Math.floor((Math.max(root.press-y, overlay.mouse-y - list.content-y) - root.gap) / root.row-height),
            Math.ceil((Math.min(root.press-x, overlay.mouse-x) - root.gap - PeopleBridge.tile-size) / root.pitch),
            Math.floor((Math.max(root.press-x, overlay.mouse-x) - root.gap) / root.pitch));
    }

    function scroll-by(dy: length) {
        list.content-y = Math.max(Math.min(0px, list.visible-height - list.content-height), Math.min(0px, list.content-y + dy));
    }

    function assign-typed() {
        if (PeopleBridge.selection > 0) {
            PeopleBridge.assign(root.match-index >= 0 && root.match-index < PeopleBridge.name-matches.length
                ? PeopleBridge.name-matches[root.match-index] : name-box.text);
            name-box.text = "";
            root.match-index = -1;
            PeopleBridge.name-edited("");
        }
    }

    // A new selection: offer the person on screen, so Enter confirms their suggestions.
    function selection-started() {
        if (name-box.text == "" && PeopleBridge.person-name != "") {
            name-box.text = PeopleBridge.person-name;
            PeopleBridge.name-edited(name-box.text);
        }
        name-box.focus();
        name-box.select-all();
    }

    HorizontalLayout {
        Rectangle {
            width: 240px;
            background: Theme.sidebar;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text { text: "People"; font-size: 15px; font-weight: 600; color: Theme.text; }

                // Naming the selected faces.
                VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 6px;
                    Text {
                        text: PeopleBridge.selection == 0 ? "Name"
                            : PeopleBridge.selection == 1 ? "Name 1 face" : "Name \{PeopleBridge.selection} faces";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text-muted;
                    }
                    name-box := LineEdit {
                        enabled: PeopleBridge.selection > 0;
                        placeholder-text: PeopleBridge.selection > 0 ? "Who is this?" : "Select faces to name them";
                        edited(text) => {
                            root.match-index = -1;
                            PeopleBridge.name-edited(text);
                        }
                        accepted => { root.assign-typed(); }
                        key-pressed(event) => {
                            if (event.text == Key.DownArrow) {
                                root.match-index = Math.min(root.match-index + 1, PeopleBridge.name-matches.length - 1);
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                root.match-index = Math.max(root.match-index - 1, -1);
                                return accept;
                            }
                            if (event.text == Key.Escape) {
                                UiLog.debug("people.name-box", "Esc: clear the name and the selection");
                                self.text = "";
                                root.match-index = -1;
                                PeopleBridge.name-edited("");
                                PeopleBridge.clear-selection();
                                return accept;
                            }
                            return reject;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            horizontal-stretch: 1;
                            text: "Assign";
                            primary: true;
                            enabled: PeopleBridge.selection > 0 && (name-box.text != "" || root.match-index >= 0);
                            clicked => { root.assign-typed(); }
                        }
                        Button {
                            horizontal-stretch: 1;
                            text: "Ignore";
                            enabled: PeopleBridge.selection > 0;
                            clicked => { PeopleBridge.ignore(); }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }

                // Finding someone in the list, and its order.
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> PeopleBridge.filter;
                        placeholder-text: "Find a person";
                        edited => { PeopleBridge.arrange(); }
                        key-pressed(event) => {
                            if (event.text == Key.Escape && self.text != "") {
                                self.text = "";
                                PeopleBridge.arrange();
                                return accept;
                            }
                            reject
                        }
                    }
                    ComboBox {
                        width: 92px;
                        model: ["Name", "Most faces", "Recent"];
                        current-index <=> PeopleBridge.sort;
                        selected => {
                            UiLog.debug("people.list", "sort by \{self.current-value}");
                            PeopleBridge.arrange();
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    plist := ListView {
                        for person[i] in PeopleBridge.people: Rectangle {
                            property <bool> drop-target: root.drag-key != -2 && root.drop-index == i
                                && person.key != -1 && person.key != root.drag-key;
                            height: root.person-row;
                            background: self.drop-target || PeopleBridge.selected == person.key ? Theme.accent-soft
                                : person-ta.has-hover && root.drag-key == -2 ? Theme.hover : transparent;
                            border-width: self.drop-target ? 2px : 0px;
                            border-color: Theme.accent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 13px;
                                        clip: true;
                                        background: Theme.well;
                                        if person.has-avatar: Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: person.avatar;
                                            image-fit: cover;
                                        }
                                        if !person.has-avatar: Text {
                                            text: person.initial;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: Theme.text-muted;
                                        }
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: person.name;
                                    font-size: 12px;
                                    font-italic: person.key == -1;
                                    color: PeopleBridge.selected == person.key ? Theme.accent : Theme.text;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: person.count;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            // Click to pick; right-click for the person's menu; drag onto
                            // another person to merge them into that one.
                            person-ta := TouchArea {
                                mouse-cursor: root.drag-key != -2 ? MouseCursor.grabbing : MouseCursor.pointer;
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down && person.key != -1) {
                                        root.menu-person = person;
                                        UiLog.debug("people.list", "menu for row \{i} (key \{person.key}, \{person.name})");
                                        person-menu-area.show({
                                            x: self.absolute-position.x + self.mouse-x - root.absolute-position.x,
                                            y: self.absolute-position.y + self.mouse-y - root.absolute-position.y });
                                    }
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                        UiLog.debug("people.list", "press on row \{i} (key \{person.key}, \{person.name})");
                                        root.dragged = false;
                                    }
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.drag-key != -2) {
                                        root.drop();
                                    }
                                }
                                moved => {
                                    if (self.pressed && person.key != -1
                                        && (root.drag-key != -2 || Math.abs(self.mouse-y - self.pressed-y) > 6px)) {
                                        if (root.drag-key == -2) {
                                            UiLog.debug("people.list", "dragging row \{i} (key \{person.key}, \{person.name})");
                                        }
                                        root.drag-key = person.key;
                                        root.drag-name = person.name;
                                        root.dragged = true;
                                        root.drag-x = self.absolute-position.x + self.mouse-x - root.absolute-position.x;
                                        root.drag-y = self.absolute-position.y + self.mouse-y - root.absolute-position.y;
                                        root.drop-index = Math.floor((self.absolute-position.y + self.mouse-y - plist.absolute-position.y - plist.content-y) / root.person-row);
                                    }
                                }
                                clicked => {
                                    if (!root.dragged) {
                                        UiLog.debug("people.list", "click on row \{i} (key \{person.key}, \{person.name}); \{root.lists-state()}");
                                        name-box.text = "";
                                        PeopleBridge.select(person.key);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle { width: 1px; background: Theme.border; }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg;

            VerticalLayout {
                padding: 20px;
                padding-bottom: 0px;
                spacing: 14px;

                Text { text: PeopleBridge.title; font-size: 20px; font-weight: 600; color: Theme.text; overflow: elide; }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    list := ListView {
                        for row[r] in PeopleBridge.rows: Rectangle {
                            height: root.row-height;
                            HorizontalLayout {
                                padding-left: root.gap;
                                padding-top: root.gap;
                                spacing: root.gap;
                                alignment: start;
                                for t[c] in row.tiles: FaceCell {
                                    tile: t;
                                    size: PeopleBridge.tile-size;
                                    hover: r == root.hover-row && c == root.hover-col;
                                }
                            }
                        }
                    }

                    // All pointer input over the faces (not the scroll bar): click, shift-click
                    // for a range, ctrl-click to toggle, drag for a rubber band, double-click
                    // to open. Faces are found from the grid's geometry.
                    overlay := TouchArea {
                        x: list.x;
                        y: list.y;
                        // The Fluent scroll bar (14px) is drawn over the list's right edge, not
                        // beside it: leave it uncovered so it can be clicked and dragged.
                        width: list.visible-width - (list.content-height > list.visible-height ? 14px : 0px);
                        height: list.visible-height;

                        changed mouse-x => { root.track(); }
                        changed mouse-y => { root.track(); }
                        changed has-hover => { root.track(); }

                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                ItemMenu.x = self.absolute-position.x + self.mouse-x;
                                ItemMenu.y = self.absolute-position.y + self.mouse-y;
                                PeopleBridge.context-menu(root.row-at(self.mouse-y - list.content-y), root.col-at(self.mouse-x));
                            }
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.press-x = self.mouse-x;
                                root.press-y = self.mouse-y - list.content-y;
                                root.press-keep = event.modifiers.shift || event.modifiers.control;
                                root.dragging = false;
                            }
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                if (root.dragging) {
                                    root.dragging = false;
                                } else {
                                    PeopleBridge.click(
                                        root.row-at(self.mouse-y - list.content-y), root.col-at(self.mouse-x),
                                        event.modifiers.shift, event.modifiers.control);
                                }
                                if (PeopleBridge.selection > 0) {
                                    root.selection-started();
                                }
                            }
                        }
                        moved => {
                            if (self.pressed && !root.dragging
                                && Math.abs(self.mouse-x - root.press-x) + Math.abs(self.mouse-y - list.content-y - root.press-y) > 6px) {
                                root.dragging = true;
                                PeopleBridge.drag-begin(root.press-keep);
                            }
                            if (root.dragging) {
                                root.drag-update();
                            }
                        }
                        double-clicked => {
                            UiLog.debug("people.faces", "double-click at \{self.mouse-x / 1px},\{self.mouse-y / 1px}");
                            PeopleBridge.open(root.row-at(self.mouse-y - list.content-y), root.col-at(self.mouse-x));
                        }
                        scroll-event(event) => {
                            root.scroll-by(event.delta-y);
                            if (root.dragging) {
                                root.drag-update();
                            }
                            accept
                        }
                    }

                    // Dragging past the top or bottom edge scrolls.
                    Timer {
                        interval: 30ms;
                        running: root.dragging && (overlay.mouse-y < 0 || overlay.mouse-y > overlay.height);
                        triggered => {
                            root.scroll-by(overlay.mouse-y < 0
                                ? Math.min(40px, -overlay.mouse-y / 2)
                                : -Math.min(40px, (overlay.mouse-y - overlay.height) / 2));
                            root.drag-update();
                        }
                    }

                    if root.dragging: Rectangle {
                        x: overlay.x + Math.min(root.press-x, overlay.mouse-x);
                        y: overlay.y + Math.max(0px, Math.min(root.press-y + list.content-y, overlay.mouse-y));
                        width: Math.abs(overlay.mouse-x - root.press-x);
                        height: Math.min(overlay.height, Math.max(root.press-y + list.content-y, overlay.mouse-y)) - self.y + overlay.y;
                        background: #2563eb1f;
                        border-width: 1px;
                        border-color: Theme.accent;
                    }

                    if PeopleBridge.empty: Text {
                        text: PeopleBridge.loading ? "Loading…" : "No faces";
                        color: Theme.text-muted;
                    }
                }

                HorizontalLayout {
                    height: 34px;
                    spacing: 12px;
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: PeopleBridge.status-text;
                        color: Theme.text-muted;
                        font-size: 12px;
                    }
                    if PeopleBridge.rows.length > 0: Text {
                        vertical-alignment: center;
                        text: "Click, Shift-click or drag to select · Ctrl-click to add";
                        color: Theme.placeholder;
                        font-size: 11px;
                    }
                    if PeopleBridge.rows.length > 0: Text {
                        vertical-alignment: center;
                        text: PeopleBridge.selection > 0 ? "Clear selection" : "Select all";
                        color: Theme.accent;
                        font-size: 12px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (PeopleBridge.selection > 0) {
                                    PeopleBridge.clear-selection();
                                } else {
                                    PeopleBridge.select-all();
                                    root.selection-started();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Matches for the name box, floating under it.
    if PeopleBridge.selection > 0 && PeopleBridge.name-matches.length > 0: Rectangle {
        x: name-box.absolute-position.x - root.absolute-position.x;
        y: name-box.absolute-position.y - root.absolute-position.y + name-box.height + 2px;
        width: name-box.width;
        height: matches.preferred-height;
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 8px;
        drop-shadow-color: #0000001f;
        matches := VerticalLayout {
            padding: 3px;
            for name[i] in PeopleBridge.name-matches: Rectangle {
                height: 26px;
                border-radius: 4px;
                background: i == root.match-index ? Theme.accent-soft : match-ta.has-hover ? Theme.hover : transparent;
                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    text: name;
                    font-size: 12px;
                    color: i == root.match-index ? Theme.accent : Theme.text;
                    overflow: elide;
                }
                match-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.match-index = i;
                        root.assign-typed();
                    }
                }
            }
        }
    }

    // The person being dragged, at the pointer.
    if root.drag-key != -2: Rectangle {
        x: root.drag-x + 12px;
        y: root.drag-y + 4px;
        width: drag-label.preferred-width + 20px;
        height: 24px;
        border-radius: 12px;
        background: #1f2328e8;
        drag-label := Text {
            text: root.drop-index >= 0 && root.drop-index < PeopleBridge.people.length
                && PeopleBridge.people[root.drop-index].key != -1 && PeopleBridge.people[root.drop-index].key != root.drag-key
                ? "Merge \{root.drag-name} into \{PeopleBridge.people[root.drop-index].name}" : root.drag-name;
            color: white;
            font-size: 12px;
        }
    }

    function track() {
        if (overlay.has-hover && !overlay.pressed) {
            root.hover-row = root.row-at(overlay.mouse-y - list.content-y);
            root.hover-col = root.col-at(overlay.mouse-x);
        } else if (!overlay.has-hover) {
            root.hover-row = -1;
            root.hover-col = -1;
        }
    }
}
