import { Theme } from "theme.slint";
import { TrashBridge } from "trash.slint";
import { FailuresBridge } from "failures.slint";

component NavButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    // A count in a small pill over the icon's corner (0: none).
    in property <int> badge;
    in property <color> badge-tone: Theme.text-muted;
    callback clicked;

    height: 58px;

    Rectangle {
        x: 8px;
        width: parent.width - 16px;
        border-radius: Theme.radius;
        background: root.active ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
        animate background { duration: 120ms; }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 22px;
                height: 22px;
                colorize: root.active ? Theme.accent : Theme.text-muted;
                if root.badge > 0: Rectangle {
                    x: 14px;
                    y: -5px;
                    width: Math.max(16px, badge-text.preferred-width + 8px);
                    height: 16px;
                    border-radius: 8px;
                    background: root.badge-tone;
                    badge-text := Text {
                        text: root.badge > 999 ? "999+" : root.badge;
                        color: white;
                        font-size: 9px;
                        font-weight: 700;
                    }
                }
            }
        }
        Text {
            text: root.label;
            font-size: 11px;
            horizontal-alignment: center;
            color: root.active ? Theme.accent : Theme.text-muted;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Sidebar inherits Rectangle {
    in property <int> active;
    callback navigate(int);

    width: 76px;
    background: Theme.sidebar;

    VerticalLayout {
        padding-top: 14px;
        padding-bottom: 10px;
        spacing: 6px;

        HorizontalLayout {
            alignment: center;
            padding-bottom: 10px;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: Theme.text;
                Text { text: "AS"; color: Theme.surface; font-weight: 700; font-size: 12px; }
            }
        }

        NavButton {
            icon: @image-url("icons/acquire.svg");
            label: "Acquire";
            active: root.active == 0;
            clicked => { root.navigate(0); }
        }
        NavButton {
            icon: @image-url("icons/review.svg");
            label: "Review";
            active: root.active == 1;
            clicked => { root.navigate(1); }
        }
        NavButton {
            icon: @image-url("icons/people.svg");
            label: "People";
            active: root.active == 2;
            clicked => { root.navigate(2); }
        }
        NavButton {
            icon: @image-url("icons/details.svg");
            label: "Details";
            active: root.active == 3;
            clicked => { root.navigate(3); }
        }

        // At the bottom: the pipeline's failures (while there are any) and the trash.
        Rectangle { vertical-stretch: 1; }
        if FailuresBridge.count > 0 || root.active == 5: NavButton {
            icon: @image-url("icons/failures.svg");
            label: "Failures";
            active: root.active == 5;
            badge: FailuresBridge.count;
            badge-tone: Theme.danger;
            clicked => { root.navigate(5); }
        }
        NavButton {
            icon: @image-url("icons/trash.svg");
            label: "Trash";
            active: root.active == 4;
            badge: TrashBridge.count;
            clicked => { root.navigate(4); }
        }
    }
}
