import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DeviceTile, DeviceState } from "types.slint";

export global AcquireBridge {
    in property <[DeviceTile]> devices;
    in property <string> output-dir;
    callback rescan();
    callback start(int);   // device row
    callback start-alt(int);  // the device's secondary action, e.g. "Scan backs"
    callback stop(int);
    callback start-all();
}

component StatusPill inherits Rectangle {
    in property <DeviceState> state;
    property <color> tone: state == DeviceState.acquiring ? Theme.accent
        : state == DeviceState.error ? Theme.danger
        : state == DeviceState.previewing ? Theme.ok
        : Theme.text-muted;

    height: 22px;
    border-radius: self.height / 2;
    background: tone.with-alpha(0.1);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.tone; }
        }
        Text {
            vertical-alignment: center;
            font-size: 11px;
            color: root.tone;
            text: root.state == DeviceState.acquiring ? "Acquiring"
                : root.state == DeviceState.error ? "Error"
                : root.state == DeviceState.previewing ? "Live"
                : "Idle";
        }
    }
}

// The device's last few saved captures, newest first; empty slots keep the strip steady.
component RecentStrip inherits HorizontalLayout {
    in property <[image]> thumbs;
    property <int> slots: 5;

    height: 56px;
    spacing: 6px;

    for thumb in root.thumbs: Rectangle {
        horizontal-stretch: 1;
        min-width: 0;
        background: Theme.well;
        border-radius: 4px;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: thumb;
            image-fit: contain;
        }
    }
    for i in Math.max(0, root.slots - root.thumbs.length): Rectangle {
        horizontal-stretch: 1;
        min-width: 0;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;
    }
}

component DevicePanel inherits Rectangle {
    in property <DeviceTile> device;
    callback start();
    callback start-alt();
    callback stop();

    property <bool> busy: device.state == DeviceState.acquiring;

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: busy ? Theme.accent : Theme.border;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text { text: root.device.name; font-weight: 600; color: Theme.text; overflow: elide; }
                Text { text: root.device.kind-label; font-size: 11px; color: Theme.text-muted; overflow: elide; }
            }
            VerticalLayout {
                alignment: center;
                StatusPill { state: root.device.state; }
            }
        }

        // Live preview. Rust pushes downscaled frames into `device.preview`.
        Rectangle {
            vertical-stretch: 1;
            background: Theme.well;
            border-radius: 6px;
            clip: true;

            if root.device.has-preview: Image {
                width: parent.width;
                height: parent.height;
                source: root.device.preview;
                image-fit: contain;
            }
            if !root.device.has-preview: Text {
                text: "Waiting for preview…";
                color: Theme.text-muted;
            }
            if root.busy && root.device.is-video: Rectangle {
                x: 10px;
                y: 10px;
                width: rec.preferred-width + 16px;
                height: 20px;
                border-radius: 4px;
                background: Theme.danger;
                rec := Text { text: "● REC"; color: white; font-size: 10px; font-weight: 700; }
            }
        }

        RecentStrip { thumbs: root.device.recent; }

        HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: root.device.detail;
                color: Theme.text-muted;
                overflow: elide;
            }
            if root.device.alt-action != "": Button {
                text: root.device.alt-action;
                enabled: !root.busy && root.device.alt-enabled && root.device.state != DeviceState.error;
                clicked => { root.start-alt(); }
            }
            Button {
                text: root.busy ? "Stop" : root.device.is-video ? "Record" : "Scan";
                primary: !root.busy;
                enabled: root.device.state != DeviceState.error;
                clicked => {
                    if (root.busy) { root.stop(); } else { root.start(); }
                }
            }
        }
    }
}

export component AcquirePage inherits Rectangle {
    property <int> count: AcquireBridge.devices.length;
    // Near-square partition: 1 → 1×1, 2 → 2×1, 3–4 → 2×2, 5–6 → 3×2, 7–9 → 3×3 ...
    property <int> cols: count <= 1 ? 1 : Math.ceil(Math.sqrt(count));
    property <int> rows: count == 0 ? 1 : Math.ceil(count / cols);
    property <length> gap: 12px;

    background: Theme.bg;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text { text: "Acquire"; font-size: 20px; font-weight: 600; color: Theme.text; }
                Text {
                    text: "\{root.count} device\{root.count == 1 ? "" : "s"} · saving to \{AcquireBridge.output-dir}";
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Button { text: "Rescan"; clicked => { AcquireBridge.rescan(); } }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Start all";
                    primary: true;
                    enabled: root.count > 0;
                    clicked => { AcquireBridge.start-all(); }
                }
            }
        }

        grid := Rectangle {
            vertical-stretch: 1;

            for device[i] in AcquireBridge.devices: DevicePanel {
                width: (grid.width - (root.cols - 1) * root.gap) / root.cols;
                height: (grid.height - (root.rows - 1) * root.gap) / root.rows;
                x: Math.mod(i, root.cols) * (self.width + root.gap);
                y: Math.floor(i / root.cols) * (self.height + root.gap);
                device: device;
                start => { AcquireBridge.start(i); }
                start-alt => { AcquireBridge.start-alt(i); }
                stop => { AcquireBridge.stop(i); }
            }

            if root.count == 0: Rectangle {
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text { text: "No capture devices detected"; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                    Text { text: "Connect a scanner or capture device, then press Rescan."; color: Theme.text-muted; horizontal-alignment: center; }
                }
            }
        }
    }
}
