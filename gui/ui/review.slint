import { ListView, LineEdit, ComboBox, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MediaRow, MediaTile, MediaKind } from "types.slint";
import { ScrollRestore, UiLog } from "nav.slint";
import { ItemMenu, TagEdit } from "menu.slint";

// A line of the tag tree: `label` is the last segment ("Alice" for `People|Alice`), indented
// by `depth`; `count` items carry it or a tag under it. Picking it filters by `query`
// (`=People|Alice`: the tag and its subtree, quoted if it has spaces).
export struct TagItem {
    label: string,
    path: string,
    query: string,
    depth: int,
    count: int,
    has-children: bool,
    expanded: bool,
}

// The "Needs attention" filters; each one that is on narrows the view further.
export struct Attention {
    review: bool,         // a rotation waits for review
    failed: bool,         // a pipeline stage failed on it
    untagged: bool,       // no tag of the user's (named faces count; detectors' tags don't)
    unknown-faces: bool,  // a face nobody named yet
    has-back: bool,       // a front with a back
}

export global ReviewBridge {
    // Virtual model: rows are produced on demand by Rust, only for what is on screen.
    in property <[MediaRow]> rows;
    in property <string> root-path;
    in property <string> status-text;
    in property <bool> indexing;
    in property <bool> empty;
    in property <[TagItem]> available-tags;
    // The size slider's value (kept across runs, `settings.rs`), and the tile size it gives.
    in-out property <float> tile-value: 160;
    out property <length> tile-size: tile-value * 1px;

    // The filter controls' state, kept here so the view can be snapshotted and restored (Back).
    in-out property <string> search-text;
    in-out property <string> tag-text;
    in-out property <string> selected-tag;
    in-out property <int> kind-filter: 0;
    in-out property <int> sort-index: 0;
    in-out property <Attention> attention;
    // 0: the search box matches names and tags; 1: it describes what the pictures show,
    // ranked by the CLIP model (the "Relevance" sort, index 4, is only offered then).
    in-out property <int> search-mode: 0;
    // "Find similar" (description mode): the path of the picture the results look like, and
    // its name for the chip; empty otherwise.
    in-out property <string> similar-to;
    in property <string> similar-name;
    // Under the search box in description mode: "Searching…", how many images are described
    // so far, or why it can't search.
    in property <string> describe-note;
    // Scroll position, reported by the page: the first row (partly) in view and how far it
    // is scrolled past.
    in-out property <int> scroll-row;
    in-out property <length> scroll-offset;
    // Set by Rust to scroll somewhere (Back).
    in property <ScrollRestore> restore;
    // Set by Rust to scroll just enough for `row` to be in view (the keyboard cursor moved;
    // `offset` is unused).
    in property <ScrollRestore> reveal;
    // How many items are selected.
    in property <int> selection-count;

    callback columns-changed(int);
    // First and last (inclusive) grid row in view; drives thumbnail priority and prefetch.
    callback viewport-changed(int, int);
    // query, tag, kind (0 all, 1 images, 2 video, 3 audio), sort (0 name, 1 date, 2 size, 3 type,
    // 4 relevance), the "Needs attention" filters, search mode, the picture to look like
    callback filter-changed(string, string, int, int, Attention, int, string);
    // Pointer input on the grid, by (row, column); -1 for neither when it missed every tile.
    // A click with Shift (range from the anchor) / Ctrl (toggle).
    callback click(int, int, /* shift */ bool, /* ctrl */ bool);
    // A rubber band starts: `keep` (Shift / Ctrl held) adds to the selection.
    callback drag-begin(bool);
    // The tiles in rows `r0..=r1`, columns `c0..=c1` (unclamped), plus what drag-begin kept.
    callback drag-to(int, int, int, int);
    callback clear-selection();
    // A key while the grid has the keyboard focus: "left", "right", "up", "down", "pageup",
    // "pagedown", "home", "end", "enter", "delete", "escape", or the key's text; returns
    // whether Rust used it.
    callback key(string, /* shift */ bool, /* ctrl */ bool) -> bool;
    // Double-click: opens the tile on the Details page.
    callback open(int, int);
    // Right-click. Shows the item context menu (`ItemMenu`).
    callback context-menu(int, int);
    // The tag tree: a node's triangle was clicked (expands or collapses it).
    callback toggle-tag(/* path */ string);
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    height: 28px;
    width: label.preferred-width + 24px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: active ? Theme.accent-soft : Theme.border;
    background: active ? Theme.accent-soft : ta.has-hover ? Theme.hover : Theme.surface;

    label := Text {
        text: root.text;
        font-size: 12px;
        color: root.active ? Theme.accent : Theme.text;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A small round badge on a tile: an icon (or a glyph) on a tinted disc.
component TileBadge inherits Rectangle {
    in property <image> icon;
    in property <string> glyph;
    in property <color> tone: #000000a0;

    width: self.height;
    border-radius: self.height / 2;
    background: root.tone;
    if root.glyph == "": Image {
        width: parent.height * 0.66;
        height: parent.height * 0.66;
        source: root.icon;
        colorize: white;
    }
    if root.glyph != "": Text {
        text: root.glyph;
        color: white;
        font-size: parent.height * 0.66;
        font-weight: 700;
    }
}

component MediaCell inherits Rectangle {
    in property <MediaTile> tile;
    in property <length> size;
    in property <bool> hover;

    width: size;

    thumb := Rectangle {
        y: 0;
        width: root.size;
        height: root.size;
        border-radius: 6px;
        clip: true;
        // Until the thumbnail arrives: its average color (softened), else the neutral well.
        background: root.tile.color.alpha > 0 ? root.tile.color.mix(Theme.well, 0.5) : Theme.well;

        if root.tile.thumb-ready: Image {
            width: parent.width;
            height: parent.height;
            source: root.tile.thumb;
            image-fit: cover;
        }
        if !root.tile.thumb-ready && root.tile.color.alpha == 0: Image {
            width: 28px;
            height: 28px;
            colorize: Theme.placeholder;
            source: root.tile.kind == MediaKind.video ? @image-url("icons/video.svg")
                : root.tile.kind == MediaKind.audio ? @image-url("icons/audio.svg")
                : @image-url("icons/image.svg");
        }
        if root.tile.kind == MediaKind.video && root.tile.thumb-ready: Rectangle {
            x: 6px;
            y: parent.height - self.height - 6px;
            width: 20px;
            height: 20px;
            border-radius: 4px;
            background: #000000a0;
            Image { source: @image-url("icons/video.svg"); width: 14px; height: 14px; colorize: white; }
        }
    }

    // Selection ring drawn on top of the thumbnail.
    Rectangle {
        y: 0;
        width: root.size;
        height: root.size;
        border-radius: 6px;
        border-width: root.tile.selected ? (root.tile.focused ? 3px : 2px) : root.tile.focused ? 2px : root.hover ? 1px : 0px;
        border-color: root.tile.selected ? Theme.accent : root.tile.focused ? Theme.accent-soft : Theme.border;
    }
    // Badges in the top-left corner, scaled with the tile: a failed stage, a rotation to
    // review, faces (amber while one isn't named), a back side.
    property <length> badge: Math.clamp(root.size * 0.11, 16px, 24px);
    HorizontalLayout {
        x: 6px;
        y: 6px;
        height: root.badge;
        spacing: 3px;
        if root.tile.failed: TileBadge { glyph: "!"; tone: #dc2626e0; }
        if root.tile.review: TileBadge { icon: @image-url("icons/rotate.svg"); tone: #d97706e0; }
        if root.tile.faces: TileBadge {
            icon: @image-url("icons/people.svg");
            tone: root.tile.unknown-faces ? #d97706e0 : #000000a0;
        }
        if root.tile.two-sided: TileBadge { icon: @image-url("icons/sides.svg"); }
    }

    // Selected: a check mark in the corner, so a multi-selection reads at a glance.
    if root.tile.selected: Rectangle {
        x: root.size - self.width - 6px;
        y: 6px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: Theme.accent;
        Text { text: "✓"; color: white; font-size: 11px; font-weight: 700; }
    }

    Text {
        x: 2px;
        y: root.size + 6px;
        width: root.size - 4px;
        text: root.tile.name;
        font-size: 12px;
        color: Theme.text;
        overflow: elide;
    }
    Text {
        x: 2px;
        y: root.size + 22px;
        width: root.size - 4px;
        text: root.tile.detail;
        font-size: 11px;
        color: Theme.text-muted;
        overflow: elide;
    }
}

export component ReviewPage inherits Rectangle {
    property <int> kind-filter <=> ReviewBridge.kind-filter;
    property <string> selected-tag <=> ReviewBridge.selected-tag;
    property <bool> attention-on: ReviewBridge.attention.review || ReviewBridge.attention.failed
        || ReviewBridge.attention.untagged || ReviewBridge.attention.unknown-faces || ReviewBridge.attention.has-back;
    property <length> gap: 14px;
    property <length> row-height: ReviewBridge.tile-size + 44px;
    property <length> pitch: ReviewBridge.tile-size + root.gap;
    property <int> columns: Math.max(1, Math.floor((list.visible-width - root.gap) / root.pitch));

    // Tile under the pointer, for the hover border.
    property <int> hover-row: -1;
    property <int> hover-col: -1;

    // Rubber band, in content coordinates (scrolling moves the grid, not the band's anchor).
    property <bool> dragging;
    property <length> press-x;
    property <length> press-y;
    property <bool> press-keep;

    // The size slider's value; Ctrl+wheel over the grid changes it too.
    property <float> tile-value <=> ReviewBridge.tile-value;

    // Tile size also picks the thumbnail resolution tier on the Rust side.
    property <length> tile-size: ReviewBridge.tile-size;
    changed columns => { ReviewBridge.columns-changed(self.columns); }
    changed tile-size => { ReviewBridge.columns-changed(self.columns); }
    init => {
        ReviewBridge.columns-changed(self.columns);
        ReviewBridge.viewport-changed(self.first-row, self.last-row);
    }

    // Visible row range, as ints so scrolling within a row costs nothing on the Rust side.
    property <int> first-row: Math.max(0, Math.floor(-list.content-y / root.row-height));
    property <int> last-row: Math.max(0, Math.floor((-list.content-y + list.visible-height - 1px) / root.row-height));
    changed first-row => { ReviewBridge.viewport-changed(self.first-row, self.last-row); }
    changed last-row => { ReviewBridge.viewport-changed(self.first-row, self.last-row); }

    // Scroll position for snapshots, and scrolling back to one.
    property <length> scrolled: -list.content-y;
    changed scrolled => {
        ReviewBridge.scroll-row = Math.floor(self.scrolled / root.row-height);
        ReviewBridge.scroll-offset = self.scrolled - ReviewBridge.scroll-row * root.row-height;
    }
    property <ScrollRestore> restore: ReviewBridge.restore;
    changed restore => {
        list.content-y = Math.max(Math.min(0px, list.visible-height - list.content-height),
            Math.min(0px, -(self.restore.row * root.row-height + self.restore.offset)));
    }
    property <ScrollRestore> reveal: ReviewBridge.reveal;
    changed reveal => {
        if (self.reveal.row * root.row-height < -list.content-y) {
            list.content-y = -self.reveal.row * root.row-height;
        } else if ((self.reveal.row + 1) * root.row-height > -list.content-y + list.visible-height) {
            list.content-y = Math.max(Math.min(0px, list.visible-height - list.content-height),
                list.visible-height - (self.reveal.row + 1) * root.row-height);
        }
    }

    // The grid takes the keyboard when the page is shown (not the search boxes).
    changed visible => {
        if (self.visible) {
            keys.focus();
        }
    }

    // Grid geometry: the row / column of the tile at a point in content coordinates
    // (-1: between tiles).
    pure function row-at(y: length) -> int {
        return y < 0 || Math.mod(y / 1px, root.row-height / 1px) < root.gap / 1px ? -1 : Math.floor(y / root.row-height);
    }
    pure function col-at(x: length) -> int {
        return x < root.gap || Math.floor((x - root.gap) / root.pitch) >= root.columns
            || Math.mod((x - root.gap) / 1px, root.pitch / 1px) > ReviewBridge.tile-size / 1px
            ? -1 : Math.floor((x - root.gap) / root.pitch);
    }

    function scroll-by(dy: length) {
        list.content-y = Math.max(Math.min(0px, list.visible-height - list.content-height), Math.min(0px, list.content-y + dy));
    }

    function drag-update() {
        // Pointer in content coordinates.
        ReviewBridge.drag-to(
            Math.floor(Math.min(root.press-y, overlay.mouse-y - list.content-y) / root.row-height),
            Math.floor((Math.max(root.press-y, overlay.mouse-y - list.content-y) - root.gap) / root.row-height),
            Math.ceil((Math.min(root.press-x, overlay.mouse-x) - root.gap - ReviewBridge.tile-size) / root.pitch),
            Math.floor((Math.max(root.press-x, overlay.mouse-x) - root.gap) / root.pitch));
    }

    pure function key-name(text: string) -> string {
        return text == Key.LeftArrow ? "left" : text == Key.RightArrow ? "right"
            : text == Key.UpArrow ? "up" : text == Key.DownArrow ? "down"
            : text == Key.PageUp ? "pageup" : text == Key.PageDown ? "pagedown"
            : text == Key.Home ? "home" : text == Key.End ? "end"
            : text == Key.Return ? "enter" : text == Key.Delete ? "delete" : text == Key.Escape ? "escape"
            : text;
    }

    function track() {
        if (overlay.has-hover && !overlay.pressed) {
            root.hover-row = root.row-at(overlay.mouse-y - list.content-y);
            root.hover-col = root.col-at(overlay.mouse-x);
        } else if (!overlay.has-hover) {
            root.hover-row = -1;
            root.hover-col = -1;
        }
    }

    function apply() {
        ReviewBridge.filter-changed(search.text, tag-search.text, root.kind-filter, sort.current-index, ReviewBridge.attention,
            ReviewBridge.search-mode, ReviewBridge.similar-to);
    }

    // Name & tags (0) or description (1); description sorts by relevance unless told otherwise.
    function set-search-mode(mode: int) {
        if (ReviewBridge.search-mode == mode) {
            return;
        }
        ReviewBridge.search-mode = mode;
        ReviewBridge.similar-to = "";
        if (mode == 1) {
            ReviewBridge.sort-index = 4;
        } else if (ReviewBridge.sort-index == 4) {
            ReviewBridge.sort-index = 0;
        }
        root.apply();
    }

    function select-tag(tag: string) {
        if (root.selected-tag == tag) {
            root.selected-tag = "";
            tag-search.text = "";
        } else {
            root.selected-tag = tag;
            tag-search.text = tag;
        }
        root.apply();
    }

    function clear-tags() {
        root.selected-tag = "";
        tag-search.text = "";
        root.apply();
    }

    background: Theme.bg;

    // The tag tree's right-click menu (`TagEdit.action` opens the dialog for it), shown where
    // a tag was right-clicked; never opened by its own right-clicks.
    property <TagItem> menu-tag;
    tag-menu-area := ContextMenuArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: false;
        Menu {
            MenuItem {
                title: "Rename…";
                activated => { TagEdit.action(root.menu-tag.path, root.menu-tag.count, root.menu-tag.has-children, "rename"); }
            }
            MenuItem {
                title: "Merge into…";
                activated => { TagEdit.action(root.menu-tag.path, root.menu-tag.count, root.menu-tag.has-children, "merge"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Delete…";
                activated => { TagEdit.action(root.menu-tag.path, root.menu-tag.count, root.menu-tag.has-children, "delete"); }
            }
        }
    }

    HorizontalLayout {
        // Full height left pane for Search & Filter (just to the right of the scan/review buttons)
        Rectangle {
            width: 240px;
            background: Theme.sidebar;

            VerticalLayout {
                padding: 16px;
                spacing: 16px;

                Text {
                    text: "Search & Filter";
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text;
                }

                // 1. Search Bar (Moved here)
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Search";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text-muted;
                    }
                    // What the box searches: names and tags, or a description of the picture.
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Chip { text: "Name & tags"; active: ReviewBridge.search-mode == 0; clicked => { root.set-search-mode(0); } }
                        Chip { text: "Description"; active: ReviewBridge.search-mode == 1; clicked => { root.set-search-mode(1); } }
                    }
                    // "Find similar": what the results look like, with × to go back to the text.
                    if ReviewBridge.similar-to != "": Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: Theme.accent-soft;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 4px;
                            Text {
                                horizontal-stretch: 1;
                                text: "Looks like \{ReviewBridge.similar-name}";
                                color: Theme.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle {
                                width: 20px;
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: similar-ta.has-hover ? Theme.hover : transparent;
                                    Text { text: "×"; color: Theme.accent; font-size: 14px; }
                                }
                                similar-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        ReviewBridge.similar-to = "";
                                        root.apply();
                                    }
                                }
                            }
                        }
                    }
                    search := LineEdit {
                        text <=> ReviewBridge.search-text;
                        placeholder-text: ReviewBridge.search-mode == 1 ? "Describe it: dog on a beach…" : "Search name or tags…";
                        edited => {
                            // Typing a description replaces "Find similar".
                            ReviewBridge.similar-to = "";
                            root.apply();
                        }
                    }
                    if ReviewBridge.search-mode == 1 && ReviewBridge.describe-note != "": Text {
                        text: ReviewBridge.describe-note;
                        color: Theme.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }

                // 2. Filter Buttons (Moved here)
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Media Type";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text-muted;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Chip { text: "All";    active: root.kind-filter == 0; clicked => { root.kind-filter = 0; root.apply(); } }
                        Chip { text: "Images"; active: root.kind-filter == 1; clicked => { root.kind-filter = 1; root.apply(); } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Chip { text: "Video";  active: root.kind-filter == 2; clicked => { root.kind-filter = 2; root.apply(); } }
                        Chip { text: "Audio";  active: root.kind-filter == 3; clicked => { root.kind-filter = 3; root.apply(); } }
                    }
                }

                // What needs the user: each chip narrows the view (with the search, type and tags).
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        Text {
                            text: "Needs attention";
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.attention-on: Text {
                            text: "Clear";
                            font-size: 11px;
                            color: Theme.accent;
                            vertical-alignment: center;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    ReviewBridge.attention = { review: false, failed: false, untagged: false, unknown-faces: false, has-back: false };
                                    root.apply();
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Chip {
                            text: "Rotation to review";
                            active: ReviewBridge.attention.review;
                            clicked => { ReviewBridge.attention.review = !ReviewBridge.attention.review; root.apply(); }
                        }
                        Chip {
                            text: "Failed";
                            active: ReviewBridge.attention.failed;
                            clicked => { ReviewBridge.attention.failed = !ReviewBridge.attention.failed; root.apply(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Chip {
                            text: "Unknown faces";
                            active: ReviewBridge.attention.unknown-faces;
                            clicked => { ReviewBridge.attention.unknown-faces = !ReviewBridge.attention.unknown-faces; root.apply(); }
                        }
                        Chip {
                            text: "Untagged";
                            active: ReviewBridge.attention.untagged;
                            clicked => { ReviewBridge.attention.untagged = !ReviewBridge.attention.untagged; root.apply(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Chip {
                            text: "Has back";
                            active: ReviewBridge.attention.has-back;
                            clicked => { ReviewBridge.attention.has-back = !ReviewBridge.attention.has-back; root.apply(); }
                        }
                    }
                }

                // 3. Tag Search & Filter (New)
                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;

                    HorizontalLayout {
                        Text {
                            text: "Tags";
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if tag-search.text != "" || root.selected-tag != "": Text {
                            text: "Clear";
                            font-size: 11px;
                            color: Theme.accent;
                            vertical-alignment: center;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.clear-tags(); }
                            }
                        }
                    }

                    tag-search := LineEdit {
                        text <=> ReviewBridge.tag-text;
                        placeholder-text: "Filter tags (e.g. tag_a and tag_b)…";
                        edited => {
                            if (self.text != root.selected-tag) {
                                root.selected-tag = "";
                            }
                            root.apply();
                        }
                    }

                    // Available Tags List
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;

                        if ReviewBridge.available-tags.length == 0: Text {
                            text: "No tags found";
                            font-size: 12px;
                            color: Theme.placeholder;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        ListView {
                            for tag in ReviewBridge.available-tags: tag-row := Rectangle {
                                property <bool> picked: root.selected-tag == tag.query || tag-search.text == tag.query;
                                height: 26px;
                                background: self.picked ? Theme.accent-soft : tag-ta.has-hover ? Theme.hover : transparent;

                                // Picks the tag (again: unpicks it); right-click for its menu.
                                tag-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-tag(tag.query); }
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                            root.menu-tag = tag;
                                            UiLog.debug("review.tags", "tag menu for \{tag.path}");
                                            tag-menu-area.show({
                                                x: self.absolute-position.x + self.mouse-x - root.absolute-position.x,
                                                y: self.absolute-position.y + self.mouse-y - root.absolute-position.y });
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 4px + tag.depth * 14px;
                                    padding-right: 10px;
                                    spacing: 2px;
                                    // Expands / collapses the tags under it.
                                    Rectangle {
                                        width: 16px;
                                        if tag.has-children: Text {
                                            text: tag.expanded ? "▾" : "▸";
                                            font-size: 11px;
                                            color: twisty-ta.has-hover ? Theme.text : Theme.text-muted;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        twisty-ta := TouchArea {
                                            enabled: tag.has-children;
                                            mouse-cursor: tag.has-children ? pointer : default;
                                            clicked => { ReviewBridge.toggle-tag(tag.path); }
                                        }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: tag.label;
                                        font-size: 12px;
                                        color: tag-row.picked ? Theme.accent : Theme.text;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: tag.count;
                                        font-size: 11px;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // 1px Border between Left Pane and Main Review
        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        // Main Review Pane
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg;

            VerticalLayout {
                padding: 20px;
                padding-bottom: 0px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: "Review"; font-size: 20px; font-weight: 600; color: Theme.text; }
                        Text { text: ReviewBridge.root-path; color: Theme.text-muted; overflow: elide; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;
                        Text { text: "Sort"; color: Theme.text-muted; vertical-alignment: center; }
                        sort := ComboBox {
                            current-index <=> ReviewBridge.sort-index;
                            width: 140px;
                            model: ReviewBridge.search-mode == 1 ? ["Name", "Date modified", "Size", "Type", "Relevance"]
                                : ["Name", "Date modified", "Size", "Type"];
                            selected => { root.apply(); }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    list := ListView {
                        for row[r] in ReviewBridge.rows: Rectangle {
                            height: root.row-height;
                            HorizontalLayout {
                                padding-left: root.gap;
                                padding-top: root.gap;
                                spacing: root.gap;
                                alignment: start;
                                for t[c] in row.tiles: MediaCell {
                                    tile: t;
                                    size: ReviewBridge.tile-size;
                                    hover: r == root.hover-row && c == root.hover-col;
                                }
                            }
                        }
                    }

                    // The grid's keys (arrows, Enter, Delete, T, R, Ctrl+A, Ctrl+C, Esc); focused on a
                    // click on the grid and when the page is shown, so the search boxes keep
                    // theirs while they are being typed in.
                    keys := FocusScope {
                        focus-on-click: false;
                        key-pressed(event) => {
                            if (ReviewBridge.key(root.key-name(event.text), event.modifiers.shift, event.modifiers.control)) {
                                return accept;
                            }
                            reject
                        }
                    }

                    // All pointer input over the tiles (not the scroll bar): click, Shift-click
                    // for a range, Ctrl-click to toggle, drag for a rubber band. It can't live in
                    // the tiles: a row is re-delivered (a new tiles model) whenever a thumbnail
                    // arrives or the selection changes, which recreates its cells, and a
                    // TouchArea recreated between two clicks never sees a double-click.
                    overlay := TouchArea {
                        x: list.x;
                        y: list.y;
                        // The Fluent scroll bar (14px) is drawn over the list's right edge, not
                        // beside it: leave it uncovered so it can be clicked and dragged.
                        width: list.visible-width - (list.content-height > list.visible-height ? 14px : 0px);
                        height: list.visible-height;

                        changed mouse-x => { root.track(); }
                        changed mouse-y => { root.track(); }
                        changed has-hover => { root.track(); }

                        double-clicked => {
                            ReviewBridge.open(root.row-at(self.mouse-y - list.content-y), root.col-at(self.mouse-x));
                        }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                ItemMenu.x = self.absolute-position.x + self.mouse-x;
                                ItemMenu.y = self.absolute-position.y + self.mouse-y;
                                ReviewBridge.context-menu(root.row-at(self.mouse-y - list.content-y), root.col-at(self.mouse-x));
                            }
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                keys.focus();
                                root.press-x = self.mouse-x;
                                root.press-y = self.mouse-y - list.content-y;
                                root.press-keep = event.modifiers.shift || event.modifiers.control;
                                root.dragging = false;
                            }
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                if (root.dragging) {
                                    root.dragging = false;
                                } else {
                                    ReviewBridge.click(
                                        root.row-at(self.mouse-y - list.content-y), root.col-at(self.mouse-x),
                                        event.modifiers.shift, event.modifiers.control);
                                }
                            }
                        }
                        moved => {
                            if (self.pressed && !root.dragging
                                && Math.abs(self.mouse-x - root.press-x) + Math.abs(self.mouse-y - list.content-y - root.press-y) > 6px) {
                                root.dragging = true;
                                ReviewBridge.drag-begin(root.press-keep);
                            }
                            if (root.dragging) {
                                root.drag-update();
                            }
                        }
                        scroll-event(event) => {
                            // Ctrl+wheel: tile size, as the slider.
                            if (event.modifiers.control) {
                                if (event.delta-y != 0) {
                                    root.tile-value = Math.clamp(root.tile-value + (event.delta-y > 0 ? 16 : -16), 96, 320);
                                }
                                return accept;
                            }
                            root.scroll-by(event.delta-y);
                            if (root.dragging) {
                                root.drag-update();
                            }
                            accept
                        }
                    }

                    // Dragging past the top or bottom edge scrolls.
                    Timer {
                        interval: 30ms;
                        running: root.dragging && (overlay.mouse-y < 0 || overlay.mouse-y > overlay.height);
                        triggered => {
                            root.scroll-by(overlay.mouse-y < 0
                                ? Math.min(40px, -overlay.mouse-y / 2)
                                : -Math.min(40px, (overlay.mouse-y - overlay.height) / 2));
                            root.drag-update();
                        }
                    }

                    if root.dragging: Rectangle {
                        x: overlay.x + Math.min(root.press-x, overlay.mouse-x);
                        y: overlay.y + Math.max(0px, Math.min(root.press-y + list.content-y, overlay.mouse-y));
                        width: Math.abs(overlay.mouse-x - root.press-x);
                        height: Math.min(overlay.height, Math.max(root.press-y + list.content-y, overlay.mouse-y)) - self.y + overlay.y;
                        background: #2563eb1f;
                        border-width: 1px;
                        border-color: Theme.accent;
                    }

                    if ReviewBridge.empty: Text {
                        text: ReviewBridge.indexing ? "Indexing…" : "No matching media";
                        color: Theme.text-muted;
                    }
                }

                HorizontalLayout {
                    height: 34px;
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: ReviewBridge.status-text;
                        color: Theme.text-muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                    // The selection, with a button to clear it.
                    if ReviewBridge.selection-count > 0: Rectangle {
                        height: 24px;
                        width: sel-row.preferred-width;
                        border-radius: 12px;
                        background: Theme.accent-soft;
                        sel-row := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 4px;
                            Text {
                                text: "\{ReviewBridge.selection-count} selected";
                                color: Theme.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 18px;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 9px;
                                    background: clear-ta.has-hover ? Theme.hover : transparent;
                                    Text { text: "×"; color: Theme.accent; font-size: 14px; }
                                }
                                clear-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { ReviewBridge.clear-selection(); }
                                }
                            }
                        }
                    }
                    Rectangle { width: 8px; }
                    Text { text: "Size"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Slider {
                        width: 110px;
                        minimum: 96;
                        maximum: 320;
                        value <=> root.tile-value;
                    }
                }
            }
        }
    }
}

