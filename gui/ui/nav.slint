// Page navigation, shared by every page. All of it is decided in Rust (`src/nav.rs`), which
// keeps a history of views (page + what it showed) so Back restores the one left.

export global NavBridge {
    // There is a view to go back to.
    in property <bool> can-go-back;
    // Sidebar: show page `i` (0 Acquire, 1 Review, 2 People, 3 Details).
    callback navigate(int);
    // Back to the previous view (Details: the back arrow and Esc).
    callback back();
}

// Restoring a grid's scroll position after Back: Rust sets the row and the offset into it,
// then bumps `serial`; the page scrolls there (Review and People).
export struct ScrollRestore {
    serial: int,
    row: int,
    offset: length,
}

// Diagnostics: what happens in the UI that Rust wouldn't otherwise see (pure-Slint state such
// as list scrolling and model sizes, keys, overlays), passed to the log (`src/nav.rs`).
// `source` says where, e.g. "people.list".
export global UiLog {
    callback debug(/* source */ string, /* message */ string);
    // For what changes continuously (scroll positions).
    callback trace(string, string);
}
