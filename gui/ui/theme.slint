// Light, low-contrast palette shared by every view.
export global Theme {
    out property <color> bg: #f6f7f9;
    out property <color> surface: #ffffff;
    out property <color> sidebar: #fbfbfc;
    out property <color> border: #e4e7eb;
    out property <color> hover: #eff1f4;
    out property <color> text: #1f2328;
    out property <color> text-muted: #6b7280;
    out property <color> accent: #2563eb;
    out property <color> accent-soft: #e8efff;
    out property <color> ok: #16a34a;
    out property <color> danger: #dc2626;
    out property <color> well: #eef0f3;        // preview / thumbnail backgrounds
    out property <color> placeholder: #b4bac4; // placeholder glyphs

    out property <length> radius: 8px;
    out property <length> font-size: 13px;
}
