// The keyboard shortcut overlay: ? or F1 (the window's key handler, app.slint) shows the
// shortcuts of the page on screen and those that work everywhere; Esc, ? / F1 again or a
// click outside closes it. The list itself is Rust's (`src/shortcuts.rs`), the one place
// shortcuts are written down.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { UiLog } from "nav.slint";

export struct HelpRow {
    keys: string,
    does: string,
}

export struct HelpSection {
    title: string,
    // Shown under the title, e.g. "On the grid, not while typing in a search box".
    note: string,
    rows: [HelpRow],
}

export global HelpBridge {
    in-out property <bool> open;
    in property <[HelpSection]> sections;
    // Asks Rust for the sections of a page (`AppWindow.page`) and opens the overlay.
    callback show(int);
}

export component HelpOverlay inherits Rectangle {
    background: #0000002a;
    TouchArea {
        clicked => {
            UiLog.debug("help", "backdrop clicked: close");
            HelpBridge.open = false;
        }
    }

    card := Rectangle {
        width: Math.min(620px, root.width - 40px);
        height: Math.min(root.height - 40px, col.preferred-height + 2px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000030;
        drop-shadow-offset-y: 6px;
        clip: true;
        TouchArea { }

        ScrollView {
            col := VerticalLayout {
                padding: 20px;
                spacing: 6px;
                HorizontalLayout {
                    Text {
                        text: "Keyboard shortcuts";
                        font-size: 16px;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    Text {
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        text: "Esc to close";
                        font-size: 11px;
                        color: Theme.text-muted;
                    }
                }
                for section in HelpBridge.sections: VerticalLayout {
                    spacing: 4px;
                    padding-top: 10px;
                    Text {
                        text: section.title;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.accent;
                    }
                    if section.note != "": Text {
                        text: section.note;
                        font-size: 11px;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    for row in section.rows: HorizontalLayout {
                        spacing: 12px;
                        Text {
                            width: 170px;
                            text: row.keys;
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: row.does;
                            font-size: 12px;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
