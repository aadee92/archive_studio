import { Button, CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PipelineBridge } from "pipeline.slint";
import { NavBridge, UiLog } from "nav.slint";
import { ItemMenu, PropRow } from "menu.slint";

// A face found in the shown image: its box as fractions of the (orientation-corrected)
// image, and who it is, if someone said so.
export struct DetailFace {
    x: float,
    y: float,
    w: float,
    h: float,
    name: string,
    // Unnamed: who it is suggested as ("" if nobody).
    suggestion: string,
}

// A highly similar item in the strip under the picture.
export struct SimilarItem {
    thumb: image,
    name: string,
    // How similar, in percent.
    score: int,
}

// A line of the info panel's tags: a kind's heading, or a tag on the item, with how to
// take it off (`key`: `kind:path`) and who proposed it ("clip 62%"; "" for the user).
export struct InfoTag {
    heading: bool,
    label: string,
    key: string,
    note: string,
}

// An item of the view the shown one was opened from, in the filmstrip above the picture.
export struct FilmItem {
    thumb: image,
    name: string,
}

export global DetailsBridge {
    in property <bool> has-item;
    in property <string> name;
    in property <string> path;
    in property <string> info;      // kind, size, dimensions once decoded
    in property <image> image;
    in property <bool> image-ready;
    // Longest edge of the file itself, in pixels (0 until known): what 100% zoom is.
    in property <int> full-edge;
    // Zoomed in past what `image` resolves: a sharper picture of part of it (`detail`), and
    // where (fractions of the image); none if `tile-w` is 0.
    in property <image> tile;
    in property <float> tile-x;
    in property <float> tile-y;
    in property <float> tile-w;
    in property <float> tile-h;
    in property <bool> loading;
    in property <bool> is-image;
    // The rotation the orient stage proposes for review, degrees clockwise; 0 = none.
    in property <int> review-cw;
    in property <string> review-detail;
    // A request to the pipeline is in flight.
    in property <bool> working;
    // Why the last request failed.
    in property <string> message;

    // Faces in the image, drawn over it; the toggles in the bottom bar (kept across items).
    in property <[DetailFace]> faces;
    in-out property <bool> show-boxes: true;
    in-out property <bool> show-names: true;
    // The face (index in `faces`) to flash when `flash-serial` changes: the one double-clicked
    // in People. It flashes even with the boxes turned off.
    in property <int> flash-face: -1;
    in property <int> flash-serial;

    // Editing the faces of the shown picture (not of the other side). The face (index in
    // `faces`) whose naming popup is open, -1 if none; Rust sets it (`edit-face`).
    in property <int> editing: -1;
    // For the popup: who that face is ("" if unnamed), who it is suggested as, the text to
    // start with, and the names matching what is typed (`edit-edited`). `edit-serial` is
    // bumped for each face opened, to start over.
    in property <string> edit-person;
    in property <string> edit-suggestion;
    in property <string> edit-text;
    in property <int> edit-serial;
    in property <[string]> edit-matches;
    // A change to the faces is being saved.
    in property <bool> face-working;
    // "Add face": drawing a box on the picture adds a face there.
    in-out property <bool> adding;
    // The face box right-clicked, for its menu (shown when `face-menu-serial` changes).
    in property <int> menu-face: -1;
    in property <string> menu-person;
    // Confirmed as `menu-person` (not just suggested): can be their cover.
    in property <bool> menu-named;
    in property <bool> menu-ignored;
    in property <int> face-menu-serial;

    // The view the item was opened from, and the items in it most like this one.
    in property <string> scope-label;
    in property <int> scope-count;
    in property <[SimilarItem]> similar;
    // The shown item's position in that view (-1 if it isn't one of its items), and the
    // filmstrip: the items around it, `film[0]` being item `film-start`.
    in property <int> scope-index: -1;
    in property <[FilmItem]> film;
    in property <int> film-start;

    // The other side of a two-sided photo (its back, or its front if this is the back),
    // "" if none; shown next to this one when `side-by-side` is on (kept across items).
    in property <string> other-side;
    in property <bool> is-back;
    in-out property <bool> side-by-side;
    in property <image> other-image;
    in property <bool> other-ready;
    in property <[DetailFace]> other-faces;

    // The info panel beside the picture (kept open across items): facts about the file and
    // its tags by kind; `info-toggled` after `info-open` changed.
    in-out property <bool> info-open;
    in property <bool> info-loading;
    in property <[PropRow]> info-rows;
    in property <[InfoTag]> info-tags;
    // Its tag box: the catalog's tags matching what is typed (`info-tag-edited`), why the
    // last one couldn't be added or removed, a change in flight, and `info-tag-serial`
    // bumped once a tag was added (the box empties).
    in property <[string]> info-tag-matches;
    in property <string> info-tag-error;
    in property <bool> info-tag-working;
    in property <int> info-tag-serial;
    callback info-toggled();
    // Take the tag `kind:path` off the item (a person: their faces on it become unknown).
    callback remove-tag(string);
    callback info-tag-edited(string);
    callback info-tag-submit(string);

    // An item menu action on the item shown (`ItemMenu.action` names: "delete", "tag",
    // "show-in-folder", "open-external"), for the buttons and keys here.
    callback item-action(string);
    // The window is full screen with only the page's own chrome (sidebar, status bar and
    // the bottom bar hidden); F11 or the button toggles it, Esc or leaving the page ends it.
    in-out property <bool> fullscreen;
    callback accept();
    callback keep();
    callback rotate(int);   // degrees clockwise
    // The part of the picture in view (fractions: left, top, right, bottom) and the width it
    // is shown at in physical pixels, when zoomed in past `image`; all 0 when no longer.
    callback detail(float, float, float, float, float);
    // Right-click on the picture (0) or on the other side next to it (1): the item menu.
    callback context-menu(int);
    // Show the other side instead.
    callback flip();
    callback side-by-side-changed();
    // The similar item at an index: double-click opens it, right-click its menu.
    callback open-similar(int);
    callback similar-menu(int);
    // Show another item of the view, in place of this one (no history): `step` by an offset
    // (Left / Right), `go-to` item i of the view (Home / End, a click in the filmstrip).
    callback step(int);
    callback go-to(int);
    // Right-click on item i of the view in the filmstrip: its menu.
    callback film-menu(int);

    // The face (index in `faces`) at a point of the picture (fractions), -1 if none; the
    // smallest one if boxes overlap.
    pure callback face-at(float, float) -> int;
    // A click on face i (-1: elsewhere on the picture): open its popup (or close it).
    callback edit-face(int);
    callback edit-edited(string);
    // Enter or a match picked in the popup: the face is that person.
    callback edit-assign(string);
    callback edit-cancel();
    // On face i, from the popup or its menu: "name" (open the popup), "not" (not who it is
    // named or suggested as), "ignore", "delete" (the box altogether), "cover" (the face stands
    // for its person in People).
    callback face-action(int, string);
    // Right-click on face i: its menu.
    callback face-menu(int);
    // "Add face": a box drawn on the picture (fractions: left, top, width, height).
    callback add-face(float, float, float, float);
}

// A face's box over the picture, with the person's name under it.
component FaceBox inherits Rectangle {
    in property <string> name;
    in property <bool> show-box;
    in property <bool> show-name;
    // Flashing: drawn regardless of the toggles; `lit` is the bright half of a pulse.
    in property <bool> flashing;
    in property <bool> lit;
    // Room under the box before the picture's bottom edge; the label goes above if short.
    in property <length> room-below;
    // Under the pointer, or its popup is open.
    in property <bool> hovered;
    in property <bool> selected;

    property <bool> box-on: root.show-box || root.flashing || root.selected;

    // Dark outline, then the light (or highlighted) box inside it, legible on any picture.
    Rectangle {
        visible: root.box-on;
        border-radius: 3px;
        border-width: root.lit ? 4px : 3px;
        border-color: #00000080;
        background: root.lit ? #facc1540 : transparent;
        animate background, border-width { duration: 120ms; }
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: 2px;
            border-width: root.lit ? 3px : root.selected || root.hovered ? 2.5px : 1.5px;
            border-color: root.lit ? #facc15 : root.flashing ? #fde68a : root.selected ? #60a5fa : root.hovered ? #ffffff : #ffffffe0;
            animate border-color, border-width { duration: 120ms; }
        }
    }

    if root.name != "" && (root.show-name || root.flashing): Rectangle {
        property <length> above: -self.height - 3px;
        width: Math.max(label.preferred-width + 10px, 24px);
        height: 18px;
        x: (root.width - self.width) / 2;
        y: root.room-below < self.height + 3px ? above : root.height + 3px;
        border-radius: 4px;
        background: root.lit ? #facc15 : #1f2328c8;
        label := Text {
            text: root.name;
            font-size: 11px;
            font-weight: 600;
            color: root.lit ? #1f2328 : #ffffff;
        }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked;

    accessible-role: button;
    accessible-label: self.label;
    accessible-action-default => { self.clicked(); }
    width: 32px;
    height: 32px;
    border-radius: Theme.radius;
    background: ta.pressed ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
    Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        colorize: ta.has-hover ? Theme.accent : Theme.text;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A picture in its box, fitted or zoomed, with its faces drawn over it, and (`dog-ear`) a
// turned-down corner that flips to the other side of the photo.
//
// Wheel zooms around the pointer, drag pans while it is larger than the box, double-click
// toggles between fitted and 100% (one pixel of the file per pixel of the screen) at the
// point clicked (or calls `open` if not `double-click-zooms`).
component Picture inherits Rectangle {
    in property <image> source;
    in property <[DetailFace]> faces;
    in property <int> flash-face: -1;
    in property <int> flash-step;
    in property <bool> dog-ear;
    // Longest edge of the file itself, in pixels: what 100% is (0: that of `source`).
    in property <int> full-edge;
    in property <bool> double-click-zooms: true;
    // The zoom, two-way so both sides of a photo shown together move as one: how many times
    // the fitted size it is shown, and the point of it (fractions) at the box's center.
    in-out property <float> zoom: 1;
    in-out property <float> cx: 0.5;
    in-out property <float> cy: 0.5;
    // Asks for a sharper `tile` (`region`) when zoomed in past what `source` resolves.
    in property <bool> detail;
    // That picture of part of the image, and where (fractions of it); none if `tile-w` is 0.
    in property <image> tile;
    in property <float> tile-x;
    in property <float> tile-y;
    in property <float> tile-w;
    in property <float> tile-h;
    // Its faces can be clicked (`face-clicked`) and right-clicked (`face-menu`); `adding`: a
    // drag draws a box (`drawn`) instead of panning. `editing`: the face whose popup is
    // open, whose box is `edit-x` … `edit-h` here.
    in property <bool> editable;
    in property <bool> adding;
    in property <int> editing: -1;
    callback face-clicked(int);
    callback face-menu(int);
    callback drawn(float, float, float, float);
    callback pressed();
    // Right-click; the pointer's window position is in `ItemMenu`.
    callback menu();
    callback flip();
    // Double-click, unless it zooms.
    callback open();
    // The part of the image in view (fractions: left, top, right, bottom) and how wide the whole
    // image is shown, in physical pixels; settled for a moment. All 0: no detail wanted.
    callback region(float, float, float, float, float);

    clip: true;

    // A pixel of the screen, as a logical length.
    property <length> device-pixel: 1phx;

    // Where `image-fit: contain` would put the picture: scaled to fit, centered.
    property <float> aspect: root.source.width / Math.max(1, root.source.height);
    property <length> fit-width: Math.min(self.width, self.height * self.aspect);
    property <length> fit-height: self.fit-width / self.aspect;
    // The zoom at which a pixel of the file is a pixel of the screen, and the bounds.
    out property <float> one-to-one: (root.full-edge > 0 ? root.full-edge : Math.max(root.source.width, root.source.height)) * self.device-pixel
        / Math.max(1px, Math.max(self.fit-width, self.fit-height));
    property <float> min-zoom: Math.min(1, self.one-to-one);
    property <float> max-zoom: Math.max(4, self.one-to-one * 8);
    // The zoom in percent of the file's own pixels.
    out property <int> percent: self.one-to-one > 0 ? Math.round(root.zoom / self.one-to-one * 100) : 100;
    out property <bool> fitted: Math.abs(root.zoom - 1) < 0.001;
    // Larger than the box: dragging (and the arrow keys) pan.
    out property <bool> pannable: self.shown-width > self.width + 0.5px || self.shown-height > self.height + 0.5px;

    out property <length> edit-x: root.shown-x + root.faces[root.editing].x * root.shown-width;
    out property <length> edit-y: root.shown-y + root.faces[root.editing].y * root.shown-height;
    out property <length> edit-w: root.faces[root.editing].w * root.shown-width;
    out property <length> edit-h: root.faces[root.editing].h * root.shown-height;

    // Where the picture is shown: centered on (`cx`, `cy`), but never leaving a gap at an edge
    // it could cover (centered if smaller than the box). Face boxes are placed in these
    // coordinates, so they follow resizes, zoom and pan.
    property <length> shown-width: self.fit-width * root.zoom;
    property <length> shown-height: self.fit-height * root.zoom;
    property <length> shown-x: root.place(root.cx, self.width, self.shown-width);
    property <length> shown-y: root.place(root.cy, self.height, self.shown-height);

    pure function place(c: float, box: length, size: length) -> length {
        return size <= box ? (box - size) / 2 : Math.max(box - size, Math.min(0px, box / 2 - c * size));
    }
    // `c` kept where `place` doesn't override it, so a pan back starts at once.
    pure function bound(c: float, box: length, size: length) -> float {
        return size <= box ? 0.5 : Math.max(box / 2 / size, Math.min(1 - box / 2 / size, c));
    }

    // Zooms to `z` (within bounds), keeping the point of the picture at (`x`, `y`) of the box there.
    public function zoom-to(z: float, x: length, y: length) {
        let fx = (x - root.shown-x) / Math.max(1px, root.shown-width);
        let fy = (y - root.shown-y) / Math.max(1px, root.shown-height);
        let nz = Math.max(root.min-zoom, Math.min(root.max-zoom, z));
        let w = root.fit-width * nz;
        let h = root.fit-height * nz;
        root.zoom = nz;
        root.cx = root.bound((root.width / 2 - x) / Math.max(1px, w) + fx, root.width, w);
        root.cy = root.bound((root.height / 2 - y) / Math.max(1px, h) + fy, root.height, h);
    }
    // Zooms by `factor` around the box's center.
    public function zoom-by(factor: float) {
        root.zoom-to(root.zoom * factor, root.width / 2, root.height / 2);
    }
    // Moves the picture by (`dx`, `dy`) from where it is.
    public function pan(dx: length, dy: length) {
        root.pan-from(root.shown-x + dx, root.shown-y + dy);
    }
    // Puts the picture's top left corner at (`x`, `y`), as far as it goes.
    function pan-from(x: length, y: length) {
        root.cx = root.bound((root.width / 2 - x) / Math.max(1px, root.shown-width), root.width, root.shown-width);
        root.cy = root.bound((root.height / 2 - y) / Math.max(1px, root.shown-height), root.height, root.shown-height);
    }

    // The detail wanted: shown larger than `source` has pixels for, and the file has more.
    property <bool> wants-detail: root.detail && root.visible
        && root.full-edge > Math.max(root.source.width, root.source.height)
        && root.shown-width / root.device-pixel > root.source.width * 1.05;
    property <float> view-left: Math.max(0, -root.shown-x / Math.max(1px, root.shown-width));
    property <float> view-top: Math.max(0, -root.shown-y / Math.max(1px, root.shown-height));
    property <float> view-right: Math.min(1, (root.width - root.shown-x) / Math.max(1px, root.shown-width));
    property <float> view-bottom: Math.min(1, (root.height - root.shown-y) / Math.max(1px, root.shown-height));
    property <string> view: root.wants-detail
        ? "\{root.view-left} \{root.view-top} \{root.view-right} \{root.view-bottom} \{root.shown-width / root.device-pixel}" : "";
    // Asked once the view has settled, not on every step of a wheel spin or drag.
    changed view => { settle.restart(); }
    settle := Timer {
        interval: 150ms;
        running: false;
        triggered => {
            self.stop();
            if (root.wants-detail) {
                root.region(root.view-left, root.view-top, root.view-right, root.view-bottom, root.shown-width / root.device-pixel);
            } else {
                root.region(0, 0, 0, 0, 0);
            }
        }
    }

    Image {
        x: root.shown-x;
        y: root.shown-y;
        width: root.shown-width;
        height: root.shown-height;
        source: root.source;
        image-fit: fill;
    }
    if root.detail && root.tile-w > 0 && root.wants-detail: Image {
        x: root.shown-x + root.tile-x * root.shown-width;
        y: root.shown-y + root.tile-y * root.shown-height;
        width: root.tile-w * root.shown-width;
        height: root.tile-h * root.shown-height;
        source: root.tile;
        image-fit: fill;
    }
    for face[i] in root.faces: FaceBox {
        x: root.shown-x + face.x * root.shown-width;
        y: root.shown-y + face.y * root.shown-height;
        width: face.w * root.shown-width;
        height: face.h * root.shown-height;
        room-below: Math.min(root.shown-y + root.shown-height, root.height) - self.y - self.height;
        name: face.name;
        show-box: DetailsBridge.show-boxes;
        show-name: DetailsBridge.show-names;
        flashing: i == root.flash-face && root.flash-step > 0;
        lit: i == root.flash-face && Math.mod(root.flash-step, 2) == 0 && root.flash-step > 0;
        hovered: i == root.hover-face;
        selected: i == root.editing;
    }
    // The box being drawn in "Add face".
    if root.adding && ta.pressed: Rectangle {
        x: Math.min(ta.pressed-x, ta.mouse-x);
        y: Math.min(ta.pressed-y, ta.mouse-y);
        width: Math.abs(ta.mouse-x - ta.pressed-x);
        height: Math.abs(ta.mouse-y - ta.pressed-y);
        border-width: 2px;
        border-radius: 3px;
        border-color: #60a5fa;
        background: #60a5fa30;
    }
    // The face under the pointer, when they can be clicked.
    property <int> hover-face: root.editable && !root.adding && ta.has-hover && !ta.pressed && DetailsBridge.show-boxes
        ? DetailsBridge.face-at((ta.mouse-x - root.shown-x) / Math.max(1px, root.shown-width), (ta.mouse-y - root.shown-y) / Math.max(1px, root.shown-height))
        : -1;
    pure function face-under(x: length, y: length) -> int {
        return root.editable && DetailsBridge.show-boxes
            ? DetailsBridge.face-at((x - root.shown-x) / Math.max(1px, root.shown-width), (y - root.shown-y) / Math.max(1px, root.shown-height))
            : -1;
    }
    ta := TouchArea {
        // Where the picture was when the drag began.
        property <length> drag-x;
        property <length> drag-y;
        mouse-cursor: root.adding ? crosshair : root.hover-face >= 0 ? pointer : !root.pannable ? default : self.pressed ? grabbing : grab;
        clicked => {
            // A click, not the end of a drag: a face's popup, or none.
            if (root.editable && !root.adding && Math.abs(self.mouse-x - self.pressed-x) < 4px && Math.abs(self.mouse-y - self.pressed-y) < 4px) {
                root.face-clicked(root.face-under(self.mouse-x, self.mouse-y));
            }
        }
        double-clicked => {
            if (root.adding) {
                return;
            }
            if (root.editable) {
                root.face-clicked(-1);
            }
            if (!root.double-click-zooms) {
                root.open();
            } else if (root.fitted) {
                root.zoom-to(root.one-to-one, self.mouse-x, self.mouse-y);
            } else {
                root.zoom-to(1, self.mouse-x, self.mouse-y);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pressed();
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.drag-x = root.shown-x;
                self.drag-y = root.shown-y;
            }
            // The box drawn, in fractions of the picture (kept within it).
            if (root.adding && event.button == PointerEventButton.left && event.kind == PointerEventKind.up
                && Math.abs(self.mouse-x - self.pressed-x) >= 6px && Math.abs(self.mouse-y - self.pressed-y) >= 6px) {
                let x1 = Math.max(0, Math.min(1, (Math.min(self.pressed-x, self.mouse-x) - root.shown-x) / Math.max(1px, root.shown-width)));
                let y1 = Math.max(0, Math.min(1, (Math.min(self.pressed-y, self.mouse-y) - root.shown-y) / Math.max(1px, root.shown-height)));
                let x2 = Math.max(0, Math.min(1, (Math.max(self.pressed-x, self.mouse-x) - root.shown-x) / Math.max(1px, root.shown-width)));
                let y2 = Math.max(0, Math.min(1, (Math.max(self.pressed-y, self.mouse-y) - root.shown-y) / Math.max(1px, root.shown-height)));
                if (x2 > x1 && y2 > y1) {
                    root.drawn(x1, y1, x2 - x1, y2 - y1);
                }
            }
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                ItemMenu.x = self.absolute-position.x + self.mouse-x;
                ItemMenu.y = self.absolute-position.y + self.mouse-y;
                if (root.face-under(self.mouse-x, self.mouse-y) >= 0) {
                    root.face-menu(root.face-under(self.mouse-x, self.mouse-y));
                } else {
                    root.menu();
                }
            }
        }
        moved => {
            if (self.pressed && root.pannable && !root.adding) {
                root.pan-from(self.drag-x + self.mouse-x - self.pressed-x, self.drag-y + self.mouse-y - self.pressed-y);
            }
        }
        scroll-event(event) => {
            if (event.delta-y == 0) {
                return reject;
            }
            // One wheel notch (60 px) zooms by about a quarter.
            root.zoom-to(root.zoom * Math.pow(2, event.delta-y / 180px), self.mouse-x, self.mouse-y);
            accept
        }
    }
    // The photo's corner, turned down: there is a back to see.
    if root.dog-ear: Rectangle {
        property <length> size: Math.min(44px, Math.min(root.shown-width, root.shown-height) / 4);
        x: root.shown-x + root.shown-width - self.size;
        y: root.shown-y + root.shown-height - self.size;
        width: self.size;
        height: self.size;
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("icons/flip.svg");
            opacity: ear.has-hover ? 1.0 : 0.85;
        }
        ear := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.flip(); }
        }
    }
}

// A small text button, for the face popup.
component LinkButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;
    height: 24px;
    width: label.preferred-width + 14px;
    border-radius: 4px;
    background: ta.has-hover && root.enabled ? Theme.hover : transparent;
    label := Text {
        text: root.text;
        font-size: 12px;
        color: !root.enabled ? Theme.placeholder : root.danger ? Theme.danger : Theme.accent;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Beside the picture: the file (name, path with Copy, dates, its own dimensions, size, kind)
// and its tags by kind, each with an × to take it off, and a box to add one.
component InfoPanel inherits Rectangle {
    // Esc in the tag box: the keys go back to the page.
    callback done();

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    property <int> serial: DetailsBridge.info-tag-serial;
    changed serial => { tag-edit.text = ""; }

    ScrollView {
        VerticalLayout {
            padding: 14px;
            spacing: 6px;
            Text {
                text: DetailsBridge.name;
                font-size: 14px;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            // Selectable, so it can be copied (Copy, or select and Ctrl+C).
            path-text := TextInput {
                text: DetailsBridge.path;
                read-only: true;
                wrap: word-wrap;
                font-size: 11px;
                color: Theme.text-muted;
            }
            HorizontalLayout {
                alignment: start;
                LinkButton {
                    text: "Copy path";
                    clicked => {
                        path-text.select-all();
                        path-text.copy();
                        path-text.clear-selection();
                        UiLog.debug("details.info", "path copied");
                    }
                }
            }
            for row in DetailsBridge.info-rows: HorizontalLayout {
                spacing: 8px;
                Text { width: 76px; text: row.label; color: Theme.text-muted; font-size: 12px; }
                Text { horizontal-stretch: 1; text: row.value; color: Theme.text; font-size: 12px; wrap: word-wrap; }
            }
            Rectangle { height: 6px; }
            Text { text: "Tags"; font-size: 13px; font-weight: 600; color: Theme.text; }
            if DetailsBridge.info-tags.length == 0 && !DetailsBridge.info-loading: Text {
                text: "No tags";
                color: Theme.text-muted;
                font-size: 12px;
            }
            for tag in DetailsBridge.info-tags: HorizontalLayout {
                padding-top: tag.heading ? 6px : 0px;
                spacing: 6px;
                height: tag.heading ? 22px : 24px;
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: tag.label;
                    color: tag.heading ? Theme.text-muted : Theme.text;
                    font-size: tag.heading ? 11px : 12px;
                    font-weight: tag.heading ? 600 : 400;
                    overflow: elide;
                }
                if !tag.heading && tag.note != "": Text {
                    vertical-alignment: center;
                    text: tag.note;
                    color: Theme.text-muted;
                    font-size: 11px;
                }
                if !tag.heading: Rectangle {
                    width: 22px;
                    border-radius: 4px;
                    background: x-ta.has-hover ? Theme.hover : transparent;
                    Text {
                        text: "×";
                        font-size: 14px;
                        color: x-ta.has-hover ? Theme.danger : Theme.text-muted;
                    }
                    x-ta := TouchArea {
                        enabled: !DetailsBridge.info-tag-working;
                        mouse-cursor: pointer;
                        clicked => {
                            UiLog.debug("details.info", "remove tag \{tag.key}");
                            DetailsBridge.remove-tag(tag.key);
                        }
                    }
                }
            }
            FocusScope {
                height: tag-edit.preferred-height;
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        tag-edit.text = "";
                        DetailsBridge.info-tag-edited("");
                        root.done();
                        return accept;
                    }
                    reject
                }
                tag-edit := LineEdit {
                    placeholder-text: "Add tag…";
                    enabled: !DetailsBridge.info-tag-working;
                    edited(text) => { DetailsBridge.info-tag-edited(text); }
                    accepted(text) => { DetailsBridge.info-tag-submit(text); }
                }
            }
            for tag in DetailsBridge.info-tag-matches: Rectangle {
                height: 24px;
                border-radius: 4px;
                background: match-ta.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    Text { text: tag; vertical-alignment: center; color: Theme.text; font-size: 12px; overflow: elide; }
                }
                match-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { DetailsBridge.info-tag-submit(tag); }
                }
            }
            if DetailsBridge.info-tag-error != "": Text {
                text: DetailsBridge.info-tag-error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}

// Naming the face `DetailsBridge.editing`, next to its box: a name box with the people whose
// names match under it (Enter or a click assigns, Esc closes), and the other things to say
// about the face.
component FacePopup inherits Rectangle {
    // The match highlighted with Up / Down (-1: the typed text).
    property <int> match-index: -1;
    // Who it is or is suggested as: "Not …" says it isn't.
    property <string> who: DetailsBridge.edit-person != "" ? DetailsBridge.edit-person : DetailsBridge.edit-suggestion;

    width: 260px;
    height: col.preferred-height;
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000030;
    drop-shadow-offset-y: 3px;

    property <int> serial: DetailsBridge.edit-serial;
    changed serial => { root.begin(); }
    init => { root.begin(); }
    // Another face (or the first): its name (or suggestion), selected so typing replaces it.
    function begin() {
        UiLog.debug("details.face-popup", "opened for face #\{DetailsBridge.editing} (\{DetailsBridge.edit-text})");
        edit.text = DetailsBridge.edit-text;
        root.match-index = -1;
        DetailsBridge.edit-edited("");
        edit.focus();
        edit.select-all();
    }
    function assign() {
        DetailsBridge.edit-assign(root.match-index >= 0 && root.match-index < DetailsBridge.edit-matches.length
            ? DetailsBridge.edit-matches[root.match-index] : edit.text);
    }

    // Clicks stay in the popup.
    TouchArea { }
    col := VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Text {
            text: DetailsBridge.edit-person != "" ? "Rename \{DetailsBridge.edit-person}"
                : DetailsBridge.edit-suggestion != "" ? "Who is this? Suggested: \{DetailsBridge.edit-suggestion}" : "Who is this?";
            font-size: 11px;
            font-weight: 600;
            color: Theme.text-muted;
            overflow: elide;
        }
        edit := LineEdit {
            placeholder-text: "Name";
            enabled: !DetailsBridge.face-working;
            edited(text) => {
                root.match-index = -1;
                DetailsBridge.edit-edited(text);
            }
            accepted => { root.assign(); }
            key-pressed(event) => {
                if (event.text == Key.DownArrow) {
                    root.match-index = Math.min(root.match-index + 1, DetailsBridge.edit-matches.length - 1);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.match-index = Math.max(root.match-index - 1, -1);
                    return accept;
                }
                if (event.text == Key.Escape) {
                    UiLog.debug("details.face-popup", "Esc: close");
                    DetailsBridge.edit-cancel();
                    return accept;
                }
                return reject;
            }
        }
        for name[i] in DetailsBridge.edit-matches: Rectangle {
            height: 24px;
            border-radius: 4px;
            background: i == root.match-index ? Theme.accent-soft : match-ta.has-hover ? Theme.hover : transparent;
            Text {
                x: 8px;
                width: parent.width - 16px;
                text: name;
                font-size: 12px;
                color: i == root.match-index ? Theme.accent : Theme.text;
                overflow: elide;
            }
            match-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.match-index = i;
                    root.assign();
                }
            }
        }
        HorizontalLayout {
            spacing: 2px;
            alignment: start;
            if root.who != "": LinkButton {
                text: "Not \{root.who}";
                enabled: !DetailsBridge.face-working;
                clicked => { DetailsBridge.face-action(DetailsBridge.editing, "not"); }
            }
            LinkButton {
                text: "Ignore";
                enabled: !DetailsBridge.face-working;
                clicked => { DetailsBridge.face-action(DetailsBridge.editing, "ignore"); }
            }
            LinkButton {
                text: "Delete box";
                danger: true;
                enabled: !DetailsBridge.face-working;
                clicked => { DetailsBridge.face-action(DetailsBridge.editing, "delete"); }
            }
        }
    }
}

// The items of the view this one was opened from, around it: the shown item is the
// highlighted one in the middle. A click shows another.
component FilmStrip inherits VerticalLayout {
    property <length> tile: 56px;
    property <length> gap: 6px;
    property <length> step: self.tile + self.gap;
    // Where item `DetailsBridge.scope-index` starts: the strip is centered on it.
    property <int> center: DetailsBridge.scope-index >= 0 ? DetailsBridge.scope-index : DetailsBridge.film-start;
    property <length> origin: (strip.width - self.tile) / 2 - (root.center - DetailsBridge.film-start) * root.step;
    property <int> hover: ta.has-hover ? root.index-at(ta.mouse-x) : -1;
    // The item of the view (not of `film`) at `x`, or -1.
    pure function index-at(x: length) -> int {
        return x < root.origin || Math.mod((x - root.origin) / 1px, root.step / 1px) > root.tile / 1px
            || Math.floor((x - root.origin) / root.step) >= DetailsBridge.film.length
            ? -1 : DetailsBridge.film-start + Math.floor((x - root.origin) / root.step);
    }

    // The item under the pointer, for the line above: copied, not bound, since `hover`
    // depends on the strip's width and the line's on its text.
    property <int> named: -1;
    changed hover => { self.named = self.hover; }

    spacing: 6px;
    Text {
        text: root.named >= DetailsBridge.film-start && root.named >= 0 && root.named - DetailsBridge.film-start < DetailsBridge.film.length
            ? DetailsBridge.film[root.named - DetailsBridge.film-start].name
            : DetailsBridge.scope-index >= 0
            ? "\{DetailsBridge.scope-index + 1} of \{DetailsBridge.scope-count} in \{DetailsBridge.scope-label}  ·  ← → to step"
            : "\{DetailsBridge.scope-count} in \{DetailsBridge.scope-label}";
        color: Theme.text-muted;
        font-size: 12px;
        overflow: elide;
    }
    strip := Rectangle {
        height: root.tile;
        clip: true;
        for item[i] in DetailsBridge.film: Rectangle {
            property <bool> current: DetailsBridge.film-start + i == DetailsBridge.scope-index;
            x: root.origin + i * root.step;
            width: root.tile;
            height: root.tile;
            border-radius: 6px;
            background: Theme.well;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: item.thumb;
                image-fit: cover;
                opacity: parent.current || DetailsBridge.film-start + i == root.hover ? 1.0 : 0.75;
            }
            Rectangle {
                border-radius: 6px;
                border-width: parent.current ? 3px : DetailsBridge.film-start + i == root.hover ? 2px : 1px;
                border-color: parent.current || DetailsBridge.film-start + i == root.hover ? Theme.accent : Theme.border;
            }
        }
        // One TouchArea over the strip: its model changes with every step.
        ta := TouchArea {
            mouse-cursor: root.hover >= 0 ? pointer : default;
            clicked => {
                if (root.index-at(self.mouse-x) >= 0) {
                    DetailsBridge.go-to(root.index-at(self.mouse-x));
                }
            }
            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                    && root.index-at(self.mouse-x) >= 0) {
                    ItemMenu.x = self.absolute-position.x + self.mouse-x;
                    ItemMenu.y = self.absolute-position.y + self.mouse-y;
                    DetailsBridge.film-menu(root.index-at(self.mouse-x));
                }
            }
        }
    }
}

// The items most like this one in the view it was opened from, best first.
component SimilarStrip inherits VerticalLayout {
    property <length> tile: 76px;
    property <length> gap: 8px;
    property <int> hover: ta.has-hover ? root.index-at(ta.mouse-x) : -1;
    pure function index-at(x: length) -> int {
        return x < 0 || Math.mod(x / 1px, (root.tile + root.gap) / 1px) > root.tile / 1px
            || Math.floor(x / (root.tile + root.gap)) >= DetailsBridge.similar.length
            ? -1 : Math.floor(x / (root.tile + root.gap));
    }

    spacing: 6px;
    Text {
        text: root.hover >= 0
            ? "\{DetailsBridge.similar[root.hover].name} · \{DetailsBridge.similar[root.hover].score}% similar"
            : "Similar in \{DetailsBridge.scope-label}";
        color: Theme.text-muted;
        font-size: 12px;
        overflow: elide;
    }
    Rectangle {
        height: root.tile;
        clip: true;
        HorizontalLayout {
            spacing: root.gap;
            alignment: start;
            for item[i] in DetailsBridge.similar: Rectangle {
                width: root.tile;
                height: root.tile;
                border-radius: 6px;
                background: Theme.well;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: item.thumb;
                    image-fit: cover;
                }
                Rectangle {
                    border-radius: 6px;
                    border-width: i == root.hover ? 2px : 1px;
                    border-color: i == root.hover ? Theme.accent : Theme.border;
                }
            }
        }
        // One TouchArea over the strip: its model is replaced per item shown, which would
        // recreate per-tile TouchAreas between the clicks of a double-click.
        ta := TouchArea {
            mouse-cursor: root.hover >= 0 ? pointer : default;
            double-clicked => {
                if (root.index-at(self.mouse-x) >= 0) {
                    DetailsBridge.open-similar(root.index-at(self.mouse-x));
                }
            }
            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                    && root.index-at(self.mouse-x) >= 0) {
                    ItemMenu.x = self.absolute-position.x + self.mouse-x;
                    ItemMenu.y = self.absolute-position.y + self.mouse-y;
                    DetailsBridge.similar-menu(root.index-at(self.mouse-x));
                }
            }
        }
    }
}

// One item, enlarged. Opened by double-clicking an item in Review, a face in People or a
// recent capture in Acquire; the back arrow (or Esc) returns to that view as it was.
export component DetailsPage inherits Rectangle {
    background: Theme.bg;

    // Take the keyboard when shown, so Esc reaches us (not a field on a hidden page). Left,
    // it lets go of the zoom (and the sharper picture held for it), "Add face" and a face's popup.
    changed visible => {
        UiLog.debug("details", "visible = \{self.visible ? "yes" : "no"}");
        if (self.visible) {
            keys.focus();
        } else {
            self.fit();
            self.slideshow = false;
            DetailsBridge.fullscreen = false;
            DetailsBridge.adding = false;
            if (DetailsBridge.editing >= 0) {
                DetailsBridge.edit-cancel();
            }
        }
    }

    // The zoom, shared by both sides of a photo shown together (see `Picture`); another item
    // shown (a step, a flip, an open) starts fitted.
    property <float> zoom: 1;
    property <float> cx: 0.5;
    property <float> cy: 0.5;
    function fit() {
        self.zoom = 1;
        self.cx = 0.5;
        self.cy = 0.5;
    }
    // The zoom for the bottom bar, copied: bound, it would depend on the picture's size,
    // which depends on the bar's height.
    property <string> zoom-label;
    property <string> zoom-now: pic.fitted ? "Fit · \{pic.percent}%" : "\{pic.percent}%";
    changed zoom-now => { self.zoom-label = self.zoom-now; }
    property <string> shown-path: DetailsBridge.path;
    changed shown-path => { self.fit(); }

    // Slideshow: the next item of the view every few seconds (after the last, the first);
    // any key or click stops it. Stepping prefetches the next pictures as Right does.
    property <bool> slideshow;
    property <int> slideshow-seconds: 5;
    function toggle-slideshow() {
        self.slideshow = !self.slideshow && DetailsBridge.scope-count > 1;
        UiLog.debug("details", "slideshow \{self.slideshow ? "started (every \{self.slideshow-seconds} s)" : "stopped"}");
        if (self.slideshow) {
            self.fit();
        }
    }
    Timer {
        interval: root.slideshow-seconds * 1s;
        running: root.slideshow && root.visible && DetailsBridge.scope-count > 1;
        triggered => {
            if (DetailsBridge.scope-index >= 0 && DetailsBridge.scope-index + 1 < DetailsBridge.scope-count) {
                DetailsBridge.step(1);
            } else {
                DetailsBridge.go-to(0);
            }
        }
    }
    function toggle-fullscreen() {
        DetailsBridge.fullscreen = !DetailsBridge.fullscreen;
        UiLog.debug("details", "full screen \{DetailsBridge.fullscreen ? "on" : "off"}");
    }

    // The tag dialog (T) closed: the keys are the page's again.
    property <bool> tag-open: ItemMenu.tag-open;
    changed tag-open => {
        if (!self.tag-open && self.visible) {
            keys.focus();
        }
    }

    // The face popup closed: the keys are the page's again.
    property <int> editing: DetailsBridge.editing;
    changed editing => {
        if (self.editing < 0 && self.visible) {
            keys.focus();
        }
    }

    // Flash: 6 half-pulses of 250 ms (3 pulses in 1.5 s) whenever Rust bumps the serial.
    property <int> flash-serial: DetailsBridge.flash-serial;
    property <int> flash-step: 0;
    changed flash-serial => { self.flash-step = 6; }
    Timer {
        interval: 250ms;
        running: root.flash-step > 0;
        triggered => { root.flash-step -= 1; }
    }

    // A face box's menu, shown by Rust (`face-menu-serial`) where it was right-clicked. Never
    // opened by its own right-clicks, and behind everything, like the item menu.
    face-menu-area := ContextMenuArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: false;
        Menu {
            MenuItem {
                title: DetailsBridge.menu-person != "" ? "Rename…" : "Name…";
                activated => { DetailsBridge.face-action(DetailsBridge.menu-face, "name"); }
            }
            MenuItem {
                title: DetailsBridge.menu-person != "" ? "Not \{DetailsBridge.menu-person}" : "Not this person";
                enabled: DetailsBridge.menu-person != "";
                activated => { DetailsBridge.face-action(DetailsBridge.menu-face, "not"); }
            }
            MenuItem {
                title: "Ignore";
                enabled: !DetailsBridge.menu-ignored;
                activated => { DetailsBridge.face-action(DetailsBridge.menu-face, "ignore"); }
            }
            MenuItem {
                title: DetailsBridge.menu-named ? "Set as cover for \{DetailsBridge.menu-person}" : "Set as cover";
                enabled: DetailsBridge.menu-named;
                activated => { DetailsBridge.face-action(DetailsBridge.menu-face, "cover"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Delete face box";
                activated => { DetailsBridge.face-action(DetailsBridge.menu-face, "delete"); }
            }
        }
    }
    keys := FocusScope {
        changed has-focus => { UiLog.debug("details", "keyboard focus \{self.has-focus ? "taken" : "lost"} (page visible \{root.visible ? "yes" : "no"})"); }
        key-pressed(event) => {
            // Any key stops a slideshow, and does nothing else.
            if (root.slideshow) {
                root.toggle-slideshow();
                return accept;
            }
            // Esc ends "Add face", closes a face's popup or leaves full screen before it goes back.
            if (event.text == Key.Escape && DetailsBridge.adding) {
                UiLog.debug("details", "Esc: stop adding a face");
                DetailsBridge.adding = false;
                return accept;
            }
            if (event.text == Key.Escape && DetailsBridge.editing >= 0) {
                UiLog.debug("details", "Esc: close the face popup");
                DetailsBridge.edit-cancel();
                return accept;
            }
            if (event.text == Key.Escape && DetailsBridge.fullscreen) {
                UiLog.debug("details", "Esc: leave full screen");
                DetailsBridge.fullscreen = false;
                return accept;
            }
            if (event.text == Key.F11) {
                root.toggle-fullscreen();
                return accept;
            }
            if (event.text == Key.Escape || (event.modifiers.alt && event.text == Key.LeftArrow)) {
                UiLog.debug("details", "\{event.text == Key.Escape ? "Esc" : "Alt+Left"} → back (page visible \{root.visible ? "yes" : "no"}, has item \{DetailsBridge.has-item ? "yes" : "no"})");
                NavBridge.back();
                return accept;
            }
            // I shows or hides the info panel.
            if (DetailsBridge.has-item && (event.text == "i" || event.text == "I") && !event.modifiers.alt && !event.modifiers.control) {
                DetailsBridge.info-open = !DetailsBridge.info-open;
                DetailsBridge.info-toggled();
                return accept;
            }
            // The item's actions, as the buttons and the item menu do them (not while a face
            // is being named or drawn).
            if (DetailsBridge.has-item && DetailsBridge.editing < 0 && !DetailsBridge.adding
                && !event.modifiers.alt && !event.modifiers.control) {
                // R turns right, Shift+R or L left.
                if ((event.text == "r" || event.text == "R" || event.text == "l" || event.text == "L") && DetailsBridge.is-image) {
                    if (!DetailsBridge.working) {
                        DetailsBridge.rotate(event.text == "r" ? 90 : 270);
                    }
                    return accept;
                }
                // Enter accepts the rotation the pipeline proposes.
                if (event.text == Key.Return && DetailsBridge.review-cw != 0 && PipelineBridge.running) {
                    if (!DetailsBridge.working) {
                        DetailsBridge.accept();
                    }
                    return accept;
                }
                if (event.text == Key.Delete) {
                    DetailsBridge.item-action("delete");
                    return accept;
                }
                if (event.text == "t" || event.text == "T") {
                    DetailsBridge.item-action("tag");
                    return accept;
                }
                if ((event.text == "f" || event.text == "F") && DetailsBridge.other-side != "") {
                    DetailsBridge.flip();
                    return accept;
                }
                if ((event.text == "b" || event.text == "B") && DetailsBridge.is-image) {
                    DetailsBridge.show-boxes = !DetailsBridge.show-boxes;
                    return accept;
                }
                if ((event.text == "n" || event.text == "N") && DetailsBridge.is-image) {
                    DetailsBridge.show-names = !DetailsBridge.show-names;
                    return accept;
                }
                if (event.text == Key.Space && DetailsBridge.scope-count > 1) {
                    root.toggle-slideshow();
                    return accept;
                }
            }
            // Zoom: + / - around the center, 0 fits, 1 shows the file's pixels 1:1.
            if (DetailsBridge.image-ready && !event.modifiers.alt) {
                if (event.text == "+" || event.text == "=") {
                    pic.zoom-by(1.25);
                    return accept;
                }
                if (event.text == "-") {
                    pic.zoom-by(0.8);
                    return accept;
                }
                if (event.text == "0") {
                    root.fit();
                    return accept;
                }
                if (event.text == "1") {
                    pic.zoom-to(pic.one-to-one, pic.width / 2, pic.height / 2);
                    return accept;
                }
            }
            // Zoomed in, the arrows pan (a tenth of the box); fitted, Left / Right step.
            if (DetailsBridge.image-ready && pic.pannable && !event.modifiers.alt && !event.modifiers.control) {
                if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                    pic.pan((event.text == Key.LeftArrow ? 1 : -1) * pic.width / 10, 0);
                    return accept;
                }
                if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                    pic.pan(0, (event.text == Key.UpArrow ? 1 : -1) * pic.height / 10);
                    return accept;
                }
            }
            // Another item of the view it was opened from.
            if (!event.modifiers.alt && !event.modifiers.control && DetailsBridge.scope-count > 1) {
                if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                    DetailsBridge.step(event.text == Key.LeftArrow ? -1 : 1);
                    return accept;
                }
                if (event.text == Key.Home || event.text == Key.End) {
                    DetailsBridge.go-to(event.text == Key.Home ? 0 : DetailsBridge.scope-count - 1);
                    return accept;
                }
            }
            reject
        }

        VerticalLayout {
            padding: 20px;
            // The bottom bar's own height pads it, unless it is hidden (full screen).
            padding-bottom: DetailsBridge.fullscreen ? 20px : 0px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 12px;
                if NavBridge.can-go-back: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/back.svg");
                        clicked => {
                            UiLog.debug("details", "back arrow clicked");
                            NavBridge.back();
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text {
                        text: DetailsBridge.has-item ? DetailsBridge.name : "Details";
                        font-size: 20px;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text { text: DetailsBridge.path; color: Theme.text-muted; overflow: elide; }
                }
                if DetailsBridge.has-item: HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    // Rotating rewrites the file (the pipeline's engine does it if it runs here).
                    if DetailsBridge.is-image: Button {
                        text: "Rotate left";
                        enabled: !DetailsBridge.working;
                        clicked => { DetailsBridge.rotate(270); }
                    }
                    if DetailsBridge.is-image: Button {
                        text: "Rotate right";
                        enabled: !DetailsBridge.working;
                        clicked => { DetailsBridge.rotate(90); }
                    }
                    // A slideshow through the view, every 3, 5 or 10 s.
                    if DetailsBridge.scope-count > 1: IconButton {
                        icon: root.slideshow ? @image-url("icons/stop.svg") : @image-url("icons/play.svg");
                        label: root.slideshow ? "Stop slideshow" : "Slideshow";
                        clicked => { root.toggle-slideshow(); }
                    }
                    if DetailsBridge.scope-count > 1: ComboBox {
                        width: 76px;
                        model: ["3 s", "5 s", "10 s"];
                        current-index: 1;
                        selected => {
                            root.slideshow-seconds = [3, 5, 10][self.current-index];
                            keys.focus();
                        }
                    }
                    IconButton {
                        icon: DetailsBridge.fullscreen ? @image-url("icons/fullscreen-exit.svg") : @image-url("icons/fullscreen.svg");
                        label: DetailsBridge.fullscreen ? "Leave full screen" : "Full screen";
                        clicked => { root.toggle-fullscreen(); }
                    }
                    Button {
                        text: "Show in folder";
                        clicked => { DetailsBridge.item-action("show-in-folder"); }
                    }
                    Button {
                        text: "Open externally";
                        clicked => { DetailsBridge.item-action("open-external"); }
                    }
                }
            }

            // The items of the view this one was opened from, around it.
            if DetailsBridge.has-item && DetailsBridge.scope-count > 1: FilmStrip { }

            HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            stage := Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                property <bool> pair: DetailsBridge.side-by-side && DetailsBridge.other-ready;
                // The front goes on the left: this item, unless it is the back.
                property <bool> this-left: !self.pair || !DetailsBridge.is-back;
                // Not in an `if`: the keys zoom it.
                pic := Picture {
                    visible: DetailsBridge.image-ready;
                    x: stage.this-left ? 12px : stage.width / 2 + 6px;
                    y: 12px;
                    width: stage.pair ? stage.width / 2 - 18px : stage.width - 24px;
                    height: stage.height - 24px;
                    source: DetailsBridge.image;
                    faces: DetailsBridge.faces;
                    flash-face: DetailsBridge.flash-face;
                    flash-step: root.flash-step;
                    dog-ear: DetailsBridge.other-side != "" && !stage.pair;
                    full-edge: DetailsBridge.full-edge;
                    zoom <=> root.zoom;
                    cx <=> root.cx;
                    cy <=> root.cy;
                    detail: true;
                    tile: DetailsBridge.tile;
                    tile-x: DetailsBridge.tile-x;
                    tile-y: DetailsBridge.tile-y;
                    tile-w: DetailsBridge.tile-w;
                    tile-h: DetailsBridge.tile-h;
                    region(left, top, right, bottom, width) => { DetailsBridge.detail(left, top, right, bottom, width); }
                    editable: DetailsBridge.is-image;
                    adding: DetailsBridge.adding;
                    editing: DetailsBridge.editing;
                    face-clicked(i) => { DetailsBridge.edit-face(i); }
                    face-menu(i) => { DetailsBridge.face-menu(i); }
                    drawn(x, y, w, h) => {
                        DetailsBridge.adding = false;
                        DetailsBridge.add-face(x, y, w, h);
                    }
                    pressed => { keys.focus(); }
                    menu => { DetailsBridge.context-menu(0); }
                    flip => { DetailsBridge.flip(); }
                }
                if DetailsBridge.image-ready && stage.pair: Picture {
                    x: stage.this-left ? stage.width / 2 + 6px : 12px;
                    y: 12px;
                    width: stage.width / 2 - 18px;
                    height: stage.height - 24px;
                    source: DetailsBridge.other-image;
                    faces: DetailsBridge.other-faces;
                    zoom <=> root.zoom;
                    cx <=> root.cx;
                    cy <=> root.cy;
                    // Double-click shows this side instead.
                    double-click-zooms: false;
                    pressed => { keys.focus(); }
                    menu => { DetailsBridge.context-menu(1); }
                    open => { DetailsBridge.flip(); }
                }
                if !DetailsBridge.image-ready: Text {
                    text: !DetailsBridge.has-item ? "Double-click an item in Review, People or Acquire to see it here"
                        : DetailsBridge.loading ? "Loading…" : "No preview for this file";
                    color: Theme.text-muted;
                }
            }
            if DetailsBridge.has-item && DetailsBridge.info-open: InfoPanel {
                width: 280px;
                done => { keys.focus(); }
            }
            }

            // Highly similar items among those of the view this one was opened from.
            if DetailsBridge.similar.length > 0: SimilarStrip { }

            if !DetailsBridge.fullscreen: HorizontalLayout {
                height: 34px;
                spacing: 8px;
                Text {
                    vertical-alignment: center;
                    text: DetailsBridge.info;
                    color: Theme.text-muted;
                    font-size: 12px;
                }
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    // The request in flight, else why the last one failed, else orient's detail.
                    text: DetailsBridge.working ? "Working…"
                        : DetailsBridge.adding ? "Draw a box around the face · Esc to cancel"
                        : DetailsBridge.message != "" ? DetailsBridge.message
                        : DetailsBridge.review-cw != 0 ? DetailsBridge.review-detail : "";
                    color: !DetailsBridge.working && DetailsBridge.message != "" ? Theme.danger : Theme.text-muted;
                    font-size: 12px;
                    overflow: elide;
                }
                // The orient stage wasn't sure enough to turn the file itself.
                if DetailsBridge.review-cw != 0: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        vertical-alignment: center;
                        text: "Rotate \{DetailsBridge.review-cw}°?";
                        color: Theme.text;
                        font-size: 12px;
                    }
                    if PipelineBridge.running: Button {
                        text: "Accept";
                        primary: true;
                        enabled: !DetailsBridge.working;
                        clicked => { DetailsBridge.accept(); }
                    }
                    if PipelineBridge.running: Button {
                        text: "Keep";
                        enabled: !DetailsBridge.working;
                        clicked => { DetailsBridge.keep(); }
                    }
                }
                // The zoom, in percent of the file's pixels.
                if DetailsBridge.image-ready && DetailsBridge.is-image: Text {
                    vertical-alignment: center;
                    text: root.zoom-label;
                    color: Theme.text-muted;
                    font-size: 12px;
                }
                if DetailsBridge.faces.length > 0: Text {
                    vertical-alignment: center;
                    text: DetailsBridge.faces.length == 1 ? "1 face" : "\{DetailsBridge.faces.length} faces";
                    color: Theme.text-muted;
                    font-size: 12px;
                }
                if DetailsBridge.other-side != "": CheckBox {
                    text: "Front & back";
                    checked <=> DetailsBridge.side-by-side;
                    toggled => { DetailsBridge.side-by-side-changed(); }
                }
                // Draw a box around a face the detector missed.
                if DetailsBridge.is-image: Button {
                    text: DetailsBridge.adding ? "Cancel" : "Add face";
                    enabled: DetailsBridge.image-ready && !DetailsBridge.face-working;
                    clicked => {
                        DetailsBridge.adding = !DetailsBridge.adding;
                        if (DetailsBridge.adding) {
                            DetailsBridge.show-boxes = true;
                            DetailsBridge.edit-cancel();
                        }
                        keys.focus();
                    }
                }
                if DetailsBridge.is-image: CheckBox {
                    text: "Face boxes";
                    enabled: DetailsBridge.faces.length > 0;
                    checked <=> DetailsBridge.show-boxes;
                }
                if DetailsBridge.is-image: CheckBox {
                    text: "Names";
                    enabled: DetailsBridge.faces.length > 0;
                    checked <=> DetailsBridge.show-names;
                }
                if DetailsBridge.has-item: CheckBox {
                    text: "Info";
                    checked <=> DetailsBridge.info-open;
                    toggled => { DetailsBridge.info-toggled(); }
                }
            }
        }

        // The popup for the face being named, under its box (above if there's no room), kept
        // in the picture's frame; it follows zoom and pan.
        if DetailsBridge.editing >= 0 && DetailsBridge.image-ready: FacePopup {
            property <length> box-x: pic.absolute-position.x - keys.absolute-position.x + pic.edit-x;
            property <length> box-y: pic.absolute-position.y - keys.absolute-position.y + pic.edit-y;
            property <length> top: stage.absolute-position.y - keys.absolute-position.y;
            property <length> bottom: self.top + stage.height;
            property <length> below: self.box-y + pic.edit-h + 8px;
            property <length> above: self.box-y - self.height - 8px;
            x: Math.max(8px, Math.min(keys.width - self.width - 8px, self.box-x + pic.edit-w / 2 - self.width / 2));
            y: self.below + self.height <= self.bottom ? self.below
                : self.above >= self.top ? self.above
                : Math.max(self.top, self.bottom - self.height);
        }
    }

    // While a slideshow runs, a click anywhere stops it (and does nothing else).
    if root.slideshow: TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.toggle-slideshow();
            }
        }
    }

    property <int> face-menu-serial: DetailsBridge.face-menu-serial;
    changed face-menu-serial => {
        UiLog.debug("details", "face menu for face #\{DetailsBridge.menu-face} at \{ItemMenu.x / 1px},\{ItemMenu.y / 1px}");
        face-menu-area.show({ x: ItemMenu.x - root.absolute-position.x, y: ItemMenu.y - root.absolute-position.y });
    }
}
