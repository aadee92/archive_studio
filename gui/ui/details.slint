import { Button, CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PipelineBridge } from "pipeline.slint";
import { NavBridge } from "nav.slint";
import { ItemMenu } from "menu.slint";

// A face found in the shown image: its box as fractions of the (orientation-corrected)
// image, and who it is, if someone said so.
export struct DetailFace {
    x: float,
    y: float,
    w: float,
    h: float,
    name: string,
}

// A highly similar item in the strip under the picture.
export struct SimilarItem {
    thumb: image,
    name: string,
    // How similar, in percent.
    score: int,
}

export global DetailsBridge {
    in property <bool> has-item;
    in property <string> name;
    in property <string> path;
    in property <string> info;      // kind, size, dimensions once decoded
    in property <image> image;
    in property <bool> image-ready;
    in property <bool> loading;
    in property <bool> is-image;
    // The rotation the orient stage proposes for review, degrees clockwise; 0 = none.
    in property <int> review-cw;
    in property <string> review-detail;
    // A request to the pipeline is in flight.
    in property <bool> working;
    // Why the last request failed.
    in property <string> message;

    // Faces in the image, drawn over it; the toggles in the bottom bar (kept across items).
    in property <[DetailFace]> faces;
    in-out property <bool> show-boxes: true;
    in-out property <bool> show-names: true;
    // The face (index in `faces`) to flash when `flash-serial` changes: the one double-clicked
    // in People. It flashes even with the boxes turned off.
    in property <int> flash-face: -1;
    in property <int> flash-serial;

    // The view the item was opened from, and the items in it most like this one.
    in property <string> scope-label;
    in property <int> scope-count;
    in property <[SimilarItem]> similar;

    // The other side of a two-sided photo (its back, or its front if this is the back),
    // "" if none; shown next to this one when `side-by-side` is on (kept across items).
    in property <string> other-side;
    in property <bool> is-back;
    in-out property <bool> side-by-side;
    in property <image> other-image;
    in property <bool> other-ready;
    in property <[DetailFace]> other-faces;

    callback open-external();
    callback accept();
    callback keep();
    callback rotate(int);   // degrees clockwise
    // Right-click on the picture (0) or on the other side next to it (1): the item menu.
    callback context-menu(int);
    // Show the other side instead.
    callback flip();
    callback side-by-side-changed();
    // The similar item at an index: double-click opens it, right-click its menu.
    callback open-similar(int);
    callback similar-menu(int);
}

// A face's box over the picture, with the person's name under it.
component FaceBox inherits Rectangle {
    in property <string> name;
    in property <bool> show-box;
    in property <bool> show-name;
    // Flashing: drawn regardless of the toggles; `lit` is the bright half of a pulse.
    in property <bool> flashing;
    in property <bool> lit;
    // Room under the box before the picture's bottom edge; the label goes above if short.
    in property <length> room-below;

    property <bool> box-on: root.show-box || root.flashing;

    // Dark outline, then the light (or highlighted) box inside it, legible on any picture.
    Rectangle {
        visible: root.box-on;
        border-radius: 3px;
        border-width: root.lit ? 4px : 3px;
        border-color: #00000080;
        background: root.lit ? #facc1540 : transparent;
        animate background, border-width { duration: 120ms; }
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: 2px;
            border-width: root.lit ? 3px : 1.5px;
            border-color: root.lit ? #facc15 : root.flashing ? #fde68a : #ffffffe0;
            animate border-color, border-width { duration: 120ms; }
        }
    }

    if root.name != "" && (root.show-name || root.flashing): Rectangle {
        property <length> above: -self.height - 3px;
        width: Math.max(label.preferred-width + 10px, 24px);
        height: 18px;
        x: (root.width - self.width) / 2;
        y: root.room-below < self.height + 3px ? above : root.height + 3px;
        border-radius: 4px;
        background: root.lit ? #facc15 : #1f2328c8;
        label := Text {
            text: root.name;
            font-size: 11px;
            font-weight: 600;
            color: root.lit ? #1f2328 : #ffffff;
        }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: Theme.radius;
    background: ta.pressed ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
    Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        colorize: ta.has-hover ? Theme.accent : Theme.text;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A picture fitted in its box, with its faces drawn over it, and (`dog-ear`) a turned-down
// corner that flips to the other side of the photo.
component Picture inherits Rectangle {
    in property <image> source;
    in property <[DetailFace]> faces;
    in property <int> flash-face: -1;
    in property <int> flash-step;
    in property <bool> dog-ear;
    callback pressed();
    // Right-click; the pointer's window position is in `ItemMenu`.
    callback menu();
    callback flip();
    // Double-click.
    callback open();

    // Where `image-fit: contain` puts the picture: scaled to fit, centered.
    // Face boxes are placed in these coordinates, so they follow resizes.
    property <float> aspect: root.source.width / Math.max(1, root.source.height);
    property <length> shown-width: Math.min(self.width, self.height * self.aspect);
    property <length> shown-height: self.shown-width / self.aspect;
    property <length> shown-x: (self.width - self.shown-width) / 2;
    property <length> shown-y: (self.height - self.shown-height) / 2;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: contain;
    }
    for face[i] in root.faces: FaceBox {
        x: root.shown-x + face.x * root.shown-width;
        y: root.shown-y + face.y * root.shown-height;
        width: face.w * root.shown-width;
        height: face.h * root.shown-height;
        room-below: root.shown-y + root.shown-height - self.y - self.height;
        name: face.name;
        show-box: DetailsBridge.show-boxes;
        show-name: DetailsBridge.show-names;
        flashing: i == root.flash-face && root.flash-step > 0;
        lit: i == root.flash-face && Math.mod(root.flash-step, 2) == 0 && root.flash-step > 0;
    }
    TouchArea {
        double-clicked => { root.open(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pressed();
            }
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                ItemMenu.x = self.absolute-position.x + self.mouse-x;
                ItemMenu.y = self.absolute-position.y + self.mouse-y;
                root.menu();
            }
        }
    }
    // The photo's corner, turned down: there is a back to see.
    if root.dog-ear: Rectangle {
        property <length> size: Math.min(44px, Math.min(root.shown-width, root.shown-height) / 4);
        x: root.shown-x + root.shown-width - self.size;
        y: root.shown-y + root.shown-height - self.size;
        width: self.size;
        height: self.size;
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("icons/flip.svg");
            opacity: ear.has-hover ? 1.0 : 0.85;
        }
        ear := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.flip(); }
        }
    }
}

// The items most like this one in the view it was opened from, best first.
component SimilarStrip inherits VerticalLayout {
    property <length> tile: 76px;
    property <length> gap: 8px;
    property <int> hover: ta.has-hover ? root.index-at(ta.mouse-x) : -1;
    pure function index-at(x: length) -> int {
        return x < 0 || Math.mod(x / 1px, (root.tile + root.gap) / 1px) > root.tile / 1px
            || Math.floor(x / (root.tile + root.gap)) >= DetailsBridge.similar.length
            ? -1 : Math.floor(x / (root.tile + root.gap));
    }

    spacing: 6px;
    Text {
        text: root.hover >= 0
            ? "\{DetailsBridge.similar[root.hover].name} · \{DetailsBridge.similar[root.hover].score}% similar"
            : "Similar in \{DetailsBridge.scope-label}";
        color: Theme.text-muted;
        font-size: 12px;
        overflow: elide;
    }
    Rectangle {
        height: root.tile;
        clip: true;
        HorizontalLayout {
            spacing: root.gap;
            alignment: start;
            for item[i] in DetailsBridge.similar: Rectangle {
                width: root.tile;
                height: root.tile;
                border-radius: 6px;
                background: Theme.well;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: item.thumb;
                    image-fit: cover;
                }
                Rectangle {
                    border-radius: 6px;
                    border-width: i == root.hover ? 2px : 1px;
                    border-color: i == root.hover ? Theme.accent : Theme.border;
                }
            }
        }
        // One TouchArea over the strip: its model is replaced per item shown, which would
        // recreate per-tile TouchAreas between the clicks of a double-click.
        ta := TouchArea {
            mouse-cursor: root.hover >= 0 ? pointer : default;
            double-clicked => {
                if (root.index-at(self.mouse-x) >= 0) {
                    DetailsBridge.open-similar(root.index-at(self.mouse-x));
                }
            }
            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                    && root.index-at(self.mouse-x) >= 0) {
                    ItemMenu.x = self.absolute-position.x + self.mouse-x;
                    ItemMenu.y = self.absolute-position.y + self.mouse-y;
                    DetailsBridge.similar-menu(root.index-at(self.mouse-x));
                }
            }
        }
    }
}

// One item, enlarged. Opened by double-clicking an item in Review, a face in People or a
// recent capture in Acquire; the back arrow (or Esc) returns to that view as it was.
export component DetailsPage inherits Rectangle {
    background: Theme.bg;

    // Take the keyboard when shown, so Esc reaches us (not a field on a hidden page).
    changed visible => {
        if (self.visible) {
            keys.focus();
        }
    }

    // Flash: 6 half-pulses of 250 ms (3 pulses in 1.5 s) whenever Rust bumps the serial.
    property <int> flash-serial: DetailsBridge.flash-serial;
    property <int> flash-step: 0;
    changed flash-serial => { self.flash-step = 6; }
    Timer {
        interval: 250ms;
        running: root.flash-step > 0;
        triggered => { root.flash-step -= 1; }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape || (event.modifiers.alt && event.text == Key.LeftArrow)) {
                NavBridge.back();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 20px;
            padding-bottom: 0px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 12px;
                if NavBridge.can-go-back: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/back.svg");
                        clicked => { NavBridge.back(); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text {
                        text: DetailsBridge.has-item ? DetailsBridge.name : "Details";
                        font-size: 20px;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text { text: DetailsBridge.path; color: Theme.text-muted; overflow: elide; }
                }
                if DetailsBridge.has-item: HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    // Rotating rewrites the file (the pipeline's engine does it if it runs here).
                    if DetailsBridge.is-image: Button {
                        text: "Rotate left";
                        enabled: !DetailsBridge.working;
                        clicked => { DetailsBridge.rotate(270); }
                    }
                    if DetailsBridge.is-image: Button {
                        text: "Rotate right";
                        enabled: !DetailsBridge.working;
                        clicked => { DetailsBridge.rotate(90); }
                    }
                    Button {
                        text: "Open externally";
                        clicked => { DetailsBridge.open-external(); }
                    }
                }
            }

            stage := Rectangle {
                vertical-stretch: 1;
                background: Theme.surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                property <bool> pair: DetailsBridge.side-by-side && DetailsBridge.other-ready;
                // The front goes on the left: this item, unless it is the back.
                property <bool> this-left: !self.pair || !DetailsBridge.is-back;
                if DetailsBridge.image-ready: Picture {
                    x: stage.this-left ? 12px : stage.width / 2 + 6px;
                    y: 12px;
                    width: stage.pair ? stage.width / 2 - 18px : stage.width - 24px;
                    height: stage.height - 24px;
                    source: DetailsBridge.image;
                    faces: DetailsBridge.faces;
                    flash-face: DetailsBridge.flash-face;
                    flash-step: root.flash-step;
                    dog-ear: DetailsBridge.other-side != "" && !stage.pair;
                    pressed => { keys.focus(); }
                    menu => { DetailsBridge.context-menu(0); }
                    flip => { DetailsBridge.flip(); }
                }
                if DetailsBridge.image-ready && stage.pair: Picture {
                    x: stage.this-left ? stage.width / 2 + 6px : 12px;
                    y: 12px;
                    width: stage.width / 2 - 18px;
                    height: stage.height - 24px;
                    source: DetailsBridge.other-image;
                    faces: DetailsBridge.other-faces;
                    pressed => { keys.focus(); }
                    menu => { DetailsBridge.context-menu(1); }
                    open => { DetailsBridge.flip(); }
                }
                if !DetailsBridge.image-ready: Text {
                    text: !DetailsBridge.has-item ? "Double-click an item in Review, People or Acquire to see it here"
                        : DetailsBridge.loading ? "Loading…" : "No preview for this file";
                    color: Theme.text-muted;
                }
            }

            // Highly similar items among those of the view this one was opened from.
            if DetailsBridge.similar.length > 0: SimilarStrip { }

            HorizontalLayout {
                height: 34px;
                spacing: 8px;
                Text {
                    vertical-alignment: center;
                    text: DetailsBridge.info;
                    color: Theme.text-muted;
                    font-size: 12px;
                }
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    // The request in flight, else why the last one failed, else orient's detail.
                    text: DetailsBridge.working ? "Working…"
                        : DetailsBridge.message != "" ? DetailsBridge.message
                        : DetailsBridge.review-cw != 0 ? DetailsBridge.review-detail : "";
                    color: !DetailsBridge.working && DetailsBridge.message != "" ? Theme.danger : Theme.text-muted;
                    font-size: 12px;
                    overflow: elide;
                }
                // The orient stage wasn't sure enough to turn the file itself.
                if DetailsBridge.review-cw != 0: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        vertical-alignment: center;
                        text: "Rotate \{DetailsBridge.review-cw}°?";
                        color: Theme.text;
                        font-size: 12px;
                    }
                    if PipelineBridge.running: Button {
                        text: "Accept";
                        primary: true;
                        enabled: !DetailsBridge.working;
                        clicked => { DetailsBridge.accept(); }
                    }
                    if PipelineBridge.running: Button {
                        text: "Keep";
                        enabled: !DetailsBridge.working;
                        clicked => { DetailsBridge.keep(); }
                    }
                }
                if DetailsBridge.faces.length > 0: Text {
                    vertical-alignment: center;
                    text: DetailsBridge.faces.length == 1 ? "1 face" : "\{DetailsBridge.faces.length} faces";
                    color: Theme.text-muted;
                    font-size: 12px;
                }
                if DetailsBridge.other-side != "": CheckBox {
                    text: "Front & back";
                    checked <=> DetailsBridge.side-by-side;
                    toggled => { DetailsBridge.side-by-side-changed(); }
                }
                if DetailsBridge.is-image: CheckBox {
                    text: "Face boxes";
                    enabled: DetailsBridge.faces.length > 0;
                    checked <=> DetailsBridge.show-boxes;
                }
                if DetailsBridge.is-image: CheckBox {
                    text: "Names";
                    enabled: DetailsBridge.faces.length > 0;
                    checked <=> DetailsBridge.show-names;
                }
            }
        }
    }
}
