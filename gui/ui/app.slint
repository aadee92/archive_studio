import { Theme } from "theme.slint";
import { Sidebar } from "sidebar.slint";
import { AcquirePage, AcquireBridge } from "acquire.slint";
import { ReviewPage, ReviewBridge } from "review.slint";
import { PeoplePage, PeopleBridge } from "people.slint";
import { DetailsPage, DetailsBridge } from "details.slint";
import { PipelineBridge } from "pipeline.slint";
import { TrashPage, TrashBridge, TrashTile, TrashRow, TrashConfirmDialog } from "trash.slint";
import { FailuresPage, FailuresBridge, FailureRow } from "failures.slint";
import { NavBridge, UiLog } from "nav.slint";
import { ItemMenu, PropRow, TagDialog, PropertiesDialog, Notice, TagEdit, TagEditDialog } from "menu.slint";
import { StatusBar, LogPanel, LogBridge, LogLine } from "log.slint";

// Re-export the bridges and data types so the Rust side can reach them.
export { AcquireBridge, ReviewBridge, PeopleBridge, DetailsBridge, PipelineBridge, NavBridge, UiLog, ItemMenu, TagEdit, PropRow, LogBridge, LogLine }
export { TrashBridge, TrashTile, TrashRow, FailuresBridge, FailureRow }
export { DeviceTile, DeviceState, MediaTile, MediaRow, MediaKind } from "types.slint";

export component AppWindow inherits Window {
    // Set by Rust only (`nav.rs`), which keeps the history for Back.
    in-out property <int> page: 0;

    title: "Archive Studio";
    full-screen <=> DetailsBridge.fullscreen;
    icon: @image-url("icons/app.svg");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 820px;
    min-height: 540px;
    background: Theme.bg;
    default-font-size: Theme.font-size;

    // The item context menu, shown by Rust (`ItemMenu.serial`) where the page was
    // right-clicked. Never opened by its own right-clicks (`enabled: false`): pages decide
    // which item, if any, was hit. Behind everything, so it never takes their input.
    menu-area := ContextMenuArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: false;
        Menu {
            MenuItem {
                title: "Rotate left";
                enabled: ItemMenu.can-rotate;
                activated => { ItemMenu.action("rotate-left"); }
            }
            MenuItem {
                title: "Rotate right";
                enabled: ItemMenu.can-rotate;
                activated => { ItemMenu.action("rotate-right"); }
            }
            MenuSeparator { }
            MenuItem {
                title: ItemMenu.count > 1 ? "Add tag to \{ItemMenu.count} items…" : "Add tag…";
                activated => { ItemMenu.action("tag"); }
            }
            Menu {
                title: "Front & back";
                MenuItem {
                    title: "Pair as back of previous item";
                    enabled: ItemMenu.can-pair-prev && ItemMenu.count <= 1;
                    activated => { ItemMenu.action("pair-prev"); }
                }
                MenuItem {
                    title: "Pair as back of next item";
                    enabled: ItemMenu.can-pair-next && ItemMenu.count <= 1;
                    activated => { ItemMenu.action("pair-next"); }
                }
                MenuSeparator { }
                MenuItem {
                    title: "Swap front & back";
                    enabled: ItemMenu.count <= 1;
                    activated => { ItemMenu.action("swap-sides"); }
                }
                MenuItem {
                    title: "Unpair";
                    enabled: ItemMenu.count <= 1;
                    activated => { ItemMenu.action("unpair"); }
                }
            }
            if ItemMenu.face-action != "": MenuItem {
                title: ItemMenu.face-action;
                activated => { ItemMenu.action("face-action"); }
            }
            if ItemMenu.cover-for != "": MenuItem {
                title: "Set as cover for \{ItemMenu.cover-for}";
                activated => { ItemMenu.action("set-cover"); }
            }
            MenuItem {
                title: "Find similar";
                enabled: ItemMenu.count <= 1;
                activated => { ItemMenu.action("find-similar"); }
            }
            MenuItem {
                title: "Show in folder";
                enabled: ItemMenu.count <= 1;
                activated => { ItemMenu.action("show-in-folder"); }
            }
            MenuItem {
                title: "Properties";
                enabled: ItemMenu.count <= 1;
                activated => { ItemMenu.action("properties"); }
            }
            MenuSeparator { }
            MenuItem {
                title: ItemMenu.count > 1 ? "Delete \{ItemMenu.count} items" : "Delete";
                activated => { ItemMenu.action("delete"); }
            }
        }
    }
    property <int> menu-serial: ItemMenu.serial;
    changed menu-serial => {
        UiLog.debug("window.menu", "context menu shown at \{ItemMenu.x / 1px},\{ItemMenu.y / 1px} (serial \{self.menu-serial})");
        menu-area.show({ x: ItemMenu.x, y: ItemMenu.y });
    }

    // Diagnostics (UiLog): the page shown, and the overlays over it.
    changed page => { UiLog.debug("window", "page = \{self.page}"); }
    property <bool> tag-open: ItemMenu.tag-open;
    changed tag-open => { UiLog.debug("window.overlay", "tag dialog \{self.tag-open ? "shown" : "hidden"}"); }
    property <bool> props-open: ItemMenu.props-open;
    changed props-open => { UiLog.debug("window.overlay", "properties dialog \{self.props-open ? "shown" : "hidden"}"); }
    property <string> tag-edit: TagEdit.mode;
    changed tag-edit => { UiLog.debug("window.overlay", self.tag-edit == "" ? "tag edit dialog hidden" : "tag edit dialog shown (\{self.tag-edit})"); }
    property <string> notice: ItemMenu.notice;
    changed notice => { UiLog.debug("window.overlay", self.notice == "" ? "notice hidden" : "notice shown: \{self.notice}"); }

    // The pages over the window-wide status bar, and the log when it's open.
    VerticalLayout {
        // Diagnostics only: logs every key on its way to the focused element (capture) and keys
        // nothing handled (bubbled up here); never takes focus or consumes a key.
        FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: false;
            capture-key-pressed(event) => {
                if (event.text == Key.Escape || event.text == Key.Return || event.text == Key.Tab
                    || event.modifiers.control || event.modifiers.alt) {
                    UiLog.debug("window.keys", "key \{root.key-name(event.text)}\{event.modifiers.control ? " +ctrl" : ""}\{event.modifiers.alt ? " +alt" : ""}\{event.modifiers.shift ? " +shift" : ""} (page \{root.page})");
                } else {
                    UiLog.trace("window.keys", "key \{root.key-name(event.text)} (page \{root.page})");
                }
                reject
            }
            // Keys nothing handled (bubbled up here): Undo / Redo, which text boxes take for
            // themselves while they have focus.
            key-pressed(event) => {
                if (event.modifiers.control && !event.modifiers.alt && (event.text == "z" || event.text == "Z")) {
                    UiLog.debug("window.keys", event.modifiers.shift ? "Ctrl+Shift+Z: redo" : "Ctrl+Z: undo");
                    ItemMenu.step(!event.modifiers.shift);
                    return accept;
                }
                if (event.modifiers.control && !event.modifiers.alt && (event.text == "y" || event.text == "Y")) {
                    UiLog.debug("window.keys", "Ctrl+Y: redo");
                    ItemMenu.step(false);
                    return accept;
                }
                UiLog.debug("window.keys", "key \{root.key-name(event.text)} not handled by any element (page \{root.page})");
                reject
            }

            // Full screen (Details), the page alone.
            HorizontalLayout {
                if !DetailsBridge.fullscreen: Sidebar {
                    active: root.page;
                    navigate(i) => { NavBridge.navigate(i); }
                }
                if !DetailsBridge.fullscreen: Rectangle { width: 1px; background: Theme.border; }

                // Every page stays alive so device previews keep running and each grid keeps its
                // scroll position, filters and selection while another page is shown.
                Rectangle {
                    horizontal-stretch: 1;
                    AcquirePage { visible: root.page == 0; }
                    ReviewPage { visible: root.page == 1; }
                    PeoplePage { visible: root.page == 2; }
                    DetailsPage { visible: root.page == 3; }
                    TrashPage { visible: root.page == 4; }
                    FailuresPage { visible: root.page == 5; }
                }
            }
        }
        if LogBridge.open && !DetailsBridge.fullscreen: LogPanel { window-height: root.height; }
        if !DetailsBridge.fullscreen: StatusBar { }
    }

    pure function key-name(text: string) -> string {
        return text == Key.Escape ? "Esc" : text == Key.Return ? "Enter" : text == Key.Tab ? "Tab"
            : text == Key.LeftArrow ? "Left" : text == Key.RightArrow ? "Right"
            : text == Key.UpArrow ? "Up" : text == Key.DownArrow ? "Down"
            : text == Key.Backspace ? "Backspace" : text == Key.Delete ? "Delete" : text == Key.F11 ? "F11"
            : text == Key.Space ? "Space" : "\"\{text}\"";
    }

    if ItemMenu.notice != "": Notice {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 80px - (LogBridge.open ? LogBridge.panel-height : 0px);
    }
    if ItemMenu.tag-open: TagDialog {
        width: root.width;
        height: root.height;
    }
    if TagEdit.mode != "": TagEditDialog {
        width: root.width;
        height: root.height;
    }
    if TrashBridge.confirm-mode != "": TrashConfirmDialog {
        width: root.width;
        height: root.height;
    }
    if ItemMenu.props-open: PropertiesDialog {
        width: root.width;
        height: root.height;
    }
}
