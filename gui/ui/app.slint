import { Theme } from "theme.slint";
import { Sidebar } from "sidebar.slint";
import { AcquirePage, AcquireBridge } from "acquire.slint";
import { ReviewPage, ReviewBridge } from "review.slint";
import { PeoplePage, PeopleBridge } from "people.slint";
import { DetailsPage, DetailsBridge } from "details.slint";
import { PipelineBridge } from "pipeline.slint";
import { NavBridge } from "nav.slint";

// Re-export the bridges and data types so the Rust side can reach them.
export { AcquireBridge, ReviewBridge, PeopleBridge, DetailsBridge, PipelineBridge, NavBridge }
export { DeviceTile, DeviceState, MediaTile, MediaRow, MediaKind } from "types.slint";

export component AppWindow inherits Window {
    // Set by Rust only (`nav.rs`), which keeps the history for Back.
    in-out property <int> page: 0;

    title: "Archive Studio";
    icon: @image-url("icons/app.svg");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 820px;
    min-height: 540px;
    background: Theme.bg;
    default-font-size: Theme.font-size;

    HorizontalLayout {
        Sidebar {
            active: root.page;
            navigate(i) => { NavBridge.navigate(i); }
        }
        Rectangle { width: 1px; background: Theme.border; }

        // Every page stays alive so device previews keep running and each grid keeps its
        // scroll position, filters and selection while another page is shown.
        Rectangle {
            horizontal-stretch: 1;
            AcquirePage { visible: root.page == 0; }
            ReviewPage { visible: root.page == 1; }
            PeoplePage { visible: root.page == 2; }
            DetailsPage { visible: root.page == 3; }
        }
    }
}
