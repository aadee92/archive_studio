// Data shapes exchanged with the Rust side.

export enum DeviceState { idle, previewing, acquiring, error }

// One connected capture device (FF-680 scanner, VHS capture card, 8mm reel digitizer, ...).
export struct DeviceTile {
    id: string,
    name: string,
    kind-label: string,
    is-video: bool,
    state: DeviceState,
    detail: string,
    preview: image,
    has-preview: bool,
    captured: int,
    recent: [image],     // newest first, at most 5 small thumbnails of saved captures
    recent-paths: [string],  // the files of `recent`, same order
    alt-action: string,  // secondary action's label (e.g. "Scan backs"); empty = none
    alt-enabled: bool,
}

export enum MediaKind { image, video, audio }

export struct MediaTile {
    index: int,        // stable entry id in the Rust-side index
    name: string,
    kind: MediaKind,
    detail: string,
    thumb: image,
    thumb-ready: bool,
    color: color,      // average color of the thumbnail, transparent until known

    selected: bool,
    focused: bool,     // the keyboard cursor (Review)

    // Badges (Review): what the catalog knows at a glance.
    faces: bool,         // has faces (not counting ignored ones)
    unknown-faces: bool, // one of them isn't named yet
    two-sided: bool,     // a front with a back, or the back
    review: bool,        // a rotation waits for review
    failed: bool,        // a pipeline stage failed on it
}

// A row of the review grid: up to `columns` tiles, or (sorted by date) the header of a
// month's items, "October 2026" with "42 items". `row` is its index in the grid.
export struct MediaRow {
    row: int,
    header: bool,
    label: string,
    detail: string,
    tiles: [MediaTile],
}
